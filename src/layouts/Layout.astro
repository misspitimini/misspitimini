---
import MainHead from '@/components/head/MainHead.astro';

export interface Props {
	title: string;
	description: string;
    image: string;
    keywords: string;
}

const { 
    title, 
    description, 
    image,
    keywords
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es">
	<head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@300;400;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Crimson+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
		<MainHead 
            title={title} 
            description={description} 
            image={image} 
            keywords={keywords} 
            canonicalUrl={canonicalUrl}
        >
            <slot name="head-scripts" />
        </MainHead>
	</head>
	<body class="selection:bg-primary/10 flex items-center justify-center font-sans antialiased tracking-wide text-gray-800">
		<div class="w-full md:max-w-7xl">
			<div class="bg-white p-0 text-center">
				<slot />
			</div>
		</div>
        <slot name="page-styles" />
	</body>
	<style is:global>
		@tailwind base;
		@tailwind components;
		@tailwind utilities;

		@layer base {
			body {
				@apply text-floral-dark antialiased;
			}
		}
	</style>
</html>
