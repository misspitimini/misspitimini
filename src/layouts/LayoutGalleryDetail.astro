<!doctype html>
<html lang="es_ES">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/images/logos/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
		<script src="/src/js/galleryDetail.js"></script>

		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,200..900;1,200..900&amp;display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>

	</head>
	<body class="selection:bg-primary/10 flex items-center justify-center font-sans antialiased tracking-wide text-gray-800">
		<h1 class="sr-only">
			Diseño floral para bodas, eventos y experiencias | misspitimini | Sara Laínez
		</h1>
		<div class="w-full md:max-w-7xl">
			<div class="bg-white p-0 shadow-soft-elevation border border-gray-50 text-center">
				<slot />
			</div>
		</div>
	</body>
	<style is:global>
		/* Usamos is:global para que afecte al HTML que mete el JS */
		#post-content-main h1 {
		  @apply font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-12 md:pb-0 text-center;
		}
		#post-content-main h2 {
		  @apply font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-12 md:pb-0 text-center;
		}
		#post-content-main h3 {
		  @apply font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-12 md:pb-0 text-center;
		}
		#post-content-main hr {
		  @apply font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-12 md:pb-0 text-center;
		}
		#post-content-main p {
		  @apply indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide  m-2 md:m-6 text-center;
		}
		#post-content-main p.card-title {
		  @apply text-xl md:text-3xl font-serif italic text-gray-800 text-center py-2;
		}
		#post-content-main ul {
		  @apply list-disc ml-6 mb-4;
		}
		#post-content-main img {
		  @apply w-full h-full object-cover shadow-2xl border border-white/20;
		}

		/* Si realmente tienes tablas en el MD y quieres darles estilo */
		#post-content-main table {
			@apply min-w-full border-collapse my-6;
		}
		
		#post-content-main td, #post-content-main th {
			@apply border border-gray-300 px-4 py-2 text-left;
		}
		#post-content-main blockquote {
			@apply border-l-4 border-gray-200 pl-6 my-6;
		}
		
	  </style>
	  	<style is:global>
			@tailwind base;
			@tailwind components;
			@tailwind utilities;
		
			@layer base {
				body {
					@apply bg-floral-beige text-floral-dark antialiased;
				}
			}
			</style>
</html>


