---
import BaseLayout from './BaseLayout.astro';

export interface Props {
	title: string;
	description: string;
    keywords: string;
}

const { title, description, keywords } = Astro.props;

---
<BaseLayout title={title} description={description} keywords={keywords}>
    <script src="../ts/blogDetail.ts"></script>
    <slot />
    <Fragment slot="page-styles">
	  	<style is:global>
            body {
				@apply block;
			}
            p {
                @apply m-0 md:m-0 text-center;
            }
            /* Usamos is:global para que afecte al HTML que mete el JS */
            main h1, h2, h3 {
            @apply font-serif text-4xl md:text-5xl text-floral-dark tracking-tight leading-tight italic m-2 text-center;
            }
            main hr {
            @apply font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-12 md:pb-0 text-center;
            }
            main p {
                @apply font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-4 md:m-6;
            }

            main p > img {
                /* 1. Evitamos que herede la sangría del texto */
                @apply block indent-0 max-w-none my-8;
                
                /* 2. En móviles: Centrado matemático perfecto basado en la posición del padre */
                @apply relative left-1/2 -translate-x-1/2;
                
                /* 3. El ancho exacto: 100% del párrafo + 1rem (los dos márgenes m-2 de 0.5rem que queremos rellenar) */
                @apply w-[calc(100%+2rem)];
                
                /* 4. En pantallas grandes (md): Cancelamos el truco y centramos normal */
                @apply md:w-1/2 md:left-auto md:translate-x-0 md:mx-auto;
            }

            main p.card-title {
            @apply text-xl md:text-3xl font-serif italic text-gray-800 text-center py-2;
            }
            main ul {
            @apply list-disc ml-12 md:ml-24 mb-4;
            }
            /* Si realmente tienes tablas en el MD y quieres darles estilo */
            main table {
                @apply min-w-full border-collapse my-6;
            }
            
            main td, main th {
                @apply border border-gray-300 px-4 py-2 text-left;
            }
            main blockquote {
                @apply border-l-4 border-gray-200 pl-6 my-6 mx-2;
            }
	    </style>
    </Fragment>
</BaseLayout>