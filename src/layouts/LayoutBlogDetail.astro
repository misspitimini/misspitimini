---
import BaseLayout from './BaseLayout.astro';

export interface Props {
	title: string;
	description: string;
    keywords: string;
    canonicalUrl: string;
}

const { title, description, keywords, canonicalUrl } = Astro.props;

---
<BaseLayout title={title} description={description} keywords={keywords} canonicalUrl={canonicalUrl}>
    <slot />
    <slot name="head-scripts" />
    <slot name="page-styles" />
    <slot name="body-scripts" />    
</BaseLayout>