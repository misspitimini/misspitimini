---
import MainHead from '@/components/head/MainHead.astro';
import '@/styles/fonts.css';

export interface Props {
	title: string;
	description: string;
    keywords: string;
    canonicalUrl: string;
}

const { 
    title, 
    description, 
    keywords,
    canonicalUrl
} = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
        <MainHead 
        title={title} 
        description={description} 
        keywords={keywords} 
        canonicalUrl={canonicalUrl}
    />
        <slot name="head-scripts" />
        <slot name="page-styles" />
	</head>
    <body>
        <div class="content">
            <slot />
        </div>
        <slot name="body-scripts" />
		<script src="/src/scripts/menu.js"></script>
    </body>
</html>
