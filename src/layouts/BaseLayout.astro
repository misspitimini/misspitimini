---
import MainHead from '@/components/head/MainHead.astro';

export interface Props {
	title: string;
	description: string;
    keywords: string;
    canonicalUrl: string;
}

const { 
    title, 
    description, 
    keywords,
    canonicalUrl
} = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@300;400;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Crimson+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
		<MainHead 
            title={title} 
            description={description} 
            keywords={keywords} 
            canonicalUrl={canonicalUrl}
        >
        <slot name="head-scripts" />
        </MainHead>
        <slot name="page-styles" />
	</head>
	<body>
		<div class="w-full md:max-w-7xl">
			<div class="bg-white p-0 text-center">
				<slot />
			</div>
		</div>
	</body>
</html>
