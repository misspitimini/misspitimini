---
import { Image } from 'astro:assets';
import novia from '@assets/images/body/bodas/novia.jpg';
import decoracionFloralEntradaCeremonia from '@assets/images/body/bodas/decoracionFloralEntradaCeremonia.jpg';
import buffetPostres from '@assets/images/body/bodas/buffetPostres.jpg';
import detallismoMesaBuffet from '@assets/images/body/bodas/detallismoMesaBuffet.jpg';
import SaraLaínezSupervisando from '@assets/images/body/bodas/SaraLaínezSupervisando.jpg';
--- 

<section class="space-y-10 px-6">
  <div class="text-center space-y-2">
    <h2 class="text-3xl font-serif">Decoración floral para bodas</h2>
    <div class="h-px w-12 bg-primary mx-auto"></div>
  </div>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
    <div class="flex-1 text-center">
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        <strong>Sara Laínez</strong> se especializa en la creación de una gran variedad de ambientes florales y asegura que cada ocasión sea única y memorable.
      </p>
      <br />
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Su equipo se encarga de todo el proceso, desde la conceptualización y el diseño hasta la instalación y el desmontaje. Trabajan en estrecha colaboración con los clientes para entender su visión y <strong>transformarla en una realidad floral</strong> que supere sus expectativas.
      </p>
      <br />
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
      Detrás de cada gran celebración hay una historia que merece ser contada con flores. Sara Laínez se especializa en curar atmósferas románticas y sofisticadas, donde cada pétalo es seleccionado con un propósito. Su pasión es traducir las emociones de sus clientes en paisajes botánicos que cautivan los sentidos y crean recuerdos imborrables.
      </p>
    </div>
  </div>
</section>

<div class="grid grid-cols-2 gap-2 md:gap-4 px-2 md:px-6">
  <div class="aspect-square overflow-hidden shadow-sm group relative">
    <Image 
      alt="Novia sonriente con un ramo de flores en la mano, con un vestido blanco y un velo, en el día de su boda" 
      class="w-full h-full object-cover" 
      loading="lazy" 
      src={novia}
      widths={[400, 800, 1200]}
      sizes="(max-width: 768px) 100vw, 50vw"
      format='webp'
    />
  </div>

  <div class="aspect-square overflow-hidden shadow-sm group relative">
    <Image 
      alt="Fotografía de espaldas de una novia y su padrino frente a la entrada de una iglesia o recinto histórico. La puerta está enmarcada por dos columnas florales altas y frondosas de follaje verde oscuro y flores blancas."
      class="w-full h-full object-cover" 
      loading="lazy" 
      src={decoracionFloralEntradaCeremonia}
      widths={[400, 800, 1200]}
      sizes="(max-width: 768px) 100vw, 50vw"
      format='webp'
    />
  </div>

  <div class="col-span-2 aspect-square md:aspect-[16/9] overflow-hidden shadow-sm group relative">
    <Image 
      alt="Mesa de postres de una boda con un pastel de varios pisos y una gran variedad de dulces, decorada con arreglos florales."
      class="w-full h-full object-cover" 
      loading="lazy" 
      src={buffetPostres}
      widths={[400, 800, 1200, 1600]}
      sizes="100vw"
      format='webp'
    />
  </div>


    <div class="aspect-square overflow-hidden shadow-sm group relative">
      <Image 
        alt="Colaboradora de Sara Laínez organizando con delicadeza una mesa de postres de lujo y preparando los últimos detalles." 
        class="w-full h-full object-cover" 
        loading="lazy" 
        src={detallismoMesaBuffet}
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 50vw"
        format='webp'
      />
    </div>
  
    <div class="aspect-square overflow-hidden shadow-sm group relative">
      <Image 
        alt="Retrato de medio cuerpo de Sara Laínez en un entorno de evento elegante mientras supervisa atenta a los detalles."
        class="w-full h-full object-cover" 
        loading="lazy" 
        src={SaraLaínezSupervisando}
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 50vw"
        format='webp'
      />
    </div>
</div>
