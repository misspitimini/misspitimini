---

import WorkshopCard from '../components/WorkshopCard.astro';
import WorkshopCardGold from '../components/WorkshopCardGold.astro';

const nextWorkshop =
{
    imgSrc: "/images/body/talleres/ramosFlores.jpg",
    imgAlt: "Taller de ramos de flores",
    date: "7 de Marzo de 2026",
    title: "Ramos de Flores",
    description: "Aprende a crear ramos de flores únicos y personalizados, combinando colores, texturas y aromas.",
    link: "/workshops/flower-bouquets",
}


const workshops = [
  {
    imgSrc: "/images/body/talleres/ramosFlores.jpg",
    imgAlt: "Taller de ramos de flores",
    title: "Ramos de Flores",
    description: "Aprende a crear ramos de flores únicos y personalizados, combinando colores, texturas y aromas.",
    link: "/workshops/flower-bouquets",
  },
  {
    imgSrc: "/images/body/talleres/centroMesa.jpg",
    imgAlt: "Taller de centros de mesa",
    title: "Centros de Mesa",
    description: "Diseña centros de mesa espectaculares para tus eventos más especiales, desde cenas íntimas hasta grandes celebraciones.",
    link: "/workshops/centerpieces",
  },
  {
    imgSrc: "/images/body/talleres/floresSecas.jpg",
    imgAlt: "Taller de flores secas",
    title: "Flores Secas",
    description: "Descubre el arte de trabajar con flores secas y crea composiciones duraderas y llenas de encanto.",
    link: "/workshops/dry-flowers",
  },
  {
    imgSrc: "/images/body/talleres/decoracionBoda.jpg",
    imgAlt: "Taller de decoración de bodas",
    title: "Decoración de Bodas",
    description: "Aprende a decorar cada rincón de una boda, desde la ceremonia hasta el banquete, con un estilo único y personal.",
    link: "/workshops/wedding-decoration",
  },
];
---
<section>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4 rounded-xl shadow-sm">
    <div class="flex-1 text-center p-4">
      <h2 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-24 md:pb-0">
        Talleres de Diseño Floral
      </h2>
      <br />
      <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Aprende a crear arreglos florales únicos y llenos de estilo con nuestros talleres presenciales.
      </p>
    </div>
  </div>
</section>


<section class="min-h-screen flex items-center justify-center p-4">
  <div class="relative p-[1px] rounded-xl bg-gradient-to-br from-yellow-200 via-yellow-500 to-yellow-700 shadow-[0_0_20px_rgba(212,175,55,0.3)] transition-transform duration-300 hover:scale-105">
      <WorkshopCardGold
          imgSrc={nextWorkshop.imgSrc}
          imgAlt={nextWorkshop.imgAlt}
          date={nextWorkshop.date}
          title={nextWorkshop.title}
          description={nextWorkshop.description}
          link={nextWorkshop.link}
      />
      </div>
</section>
<section class="bg-white py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {workshops.map((workshop) => (
        <WorkshopCard
          imgSrc={workshop.imgSrc}
          imgAlt={workshop.imgAlt}
          title={workshop.title}
          description={workshop.description}
          link={workshop.link}
        />
      ))}
    </div>
  </div>
</section>
