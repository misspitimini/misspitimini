--- 
import SectionTitle from '@/components/commons/SectionTitle.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import ContentSection from '../layout/ContentSection.astro';

import { getBlogs } from '@/services/blog';

// Obtenemos las galerías directamente en el componente.
const blogs = await getBlogs();
---

<ContentSection>
    <SectionTitle>Nuestro Blog</SectionTitle>
  <div class="max-w-5xl mx-auto px-2 md:px-10 text-justify text-floral-dark/80 leading-relaxed space-y-4">
    <p>
      Las flores no solo decoran espacios; <strong>marcan capítulos de nuestra vida</strong>. En este rincón, compartimos la magia detrás de cada brote: desde la alegría de un regalo inesperado hasta el arte de cuidar tu primer jardín en casa. Porque cada flor tiene una historia, y queremos que nos ayudes a <strong>contarla</strong>.
    </p>
  </div>
  <br/>
  <div id="blog-container" class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-4 pt-4 gap-8">  
  {blogs.length > 0 ? (
    blogs.map(blog => (
    <BlogCard 
      title={blog.title}
      description={blog.description}
      slug={blog.slug}
      imgSrc={blog.imgSrc}
      imgAlt={blog.description};
      pubDate={blog.pubDate}
       />
    ))
  ) : (
    <p class="col-span-full text-center">No se han podido cargar los blogs en este momento. Por favor, inténtalo de nuevo más tarde.</p>
  )}
  </div>
</ContentSection>

<template id="card-blog-template" class="hidden">
  <BlogCard 
    title='Título de ejemplo'
    description='Descripción de ejemplo...'
    slug= 'ejemplo-slug'
    imgSrc='https://example.com/image.jpg'
    imgAlt='Descripción de ejemplo...'
    pubDate='1 de Enero de 1990'
   />
</template>

<script src="../../ts/blog.ts"></script>
