---
import CustomLink from '@/components/commons/CustomLink.astro';
import { slugify } from "@/ts/utils.ts";

interface Props {
  title: string;
  description: string;
  slug: string;
  imgSrc: string;
  imgAlt: string;
  pubDate: string;
}

const { title, description, slug, imgSrc, imgAlt, pubDate} = Astro.props;
---

<div id={slug} class="relative w-full pt-4 overflow-hidden">
  <img class="card-img h-auto w-full object-cover" src={imgSrc} alt={imgAlt} loading="lazy" />
  <div class="mt-4 mb-4">
    <CustomLink class="card-link" href={`/blog/${slugify(slug)}/`}>Leer más</CustomLink>
  </div>
  <div class="px-2"> 
    <p class="card-pub-date text-sm text-gray-500 text-center">{pubDate}</p>
    <h3 class="card-title text-xl md:text-3xl font-serif italic text-gray-800 min-h-[4rem]">{title}</h3>
    <p class="card-description text-[16px] text-floral-dark/60 min-h-[5rem] line-clamp-3 text-center">
      {description}
    </p>
  </div>
</div>
