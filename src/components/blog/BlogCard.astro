---
import type { CollectionEntry } from "astro:content";
import Link from "@components/commons/CustomLink.astro";
import { slugify } from "../../utils/utils.js";
interface Props {
	post: CollectionEntry<"blog">;
}

const { data, slug } = Astro.props.post;
---

<div class="overflow-hidden w-fit">
    <img class="card-img h-auto w-full object-cover" src={data.image} alt={data.title} />
    
    <div class="px-2"> <h3 class="card-title text-xl md:text-3xl font-serif italic text-gray-800">{data.title}</h3>
      <p class="card-description text-[16px] text-floral-dark/60">
        {data.description}
      </p>
      <div class="mt-4">
        <a href={`/blog/${slugify(slug)}/`} class="card-link text-base font-medium text-pink-500 hover:text-pink-600">
          Leer más &rarr;
        </a>
      </div>
    </div>
</div>
