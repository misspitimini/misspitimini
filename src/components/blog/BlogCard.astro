---
import CustomLink from '@/components/commons/CustomLink.astro';
import type { CollectionEntry } from "astro:content";
import { slugify } from "@/ts/utils.ts";

interface Props {
	data: {
    title: string;
    description: string;
    author: string;
    pubDate: string;
    tags: string[];
    heroImage: string;
    slug: string;
  };
}

const { data } = Astro.props;

const formattedDate = new Date(data.pubDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="relative w-full pt-4 overflow-hidden">
  <img class="card-img h-auto w-full object-cover" src={data.heroImage} alt={data.title} loading="lazy" />
  <div class="mt-4 mb-4">
    <CustomLink class="card-link" href={`/blog/${slugify(data.slug)}/`}>Leer más</CustomLink>
  </div>
  <div class="px-2"> 
    <p class="text-sm text-gray-500">{formattedDate}</p>
    <h3 class="card-title text-xl md:text-3xl font-serif italic text-gray-800 min-h-[4rem]">{data.title}</h3>
    <p class="card-description text-[16px] text-floral-dark/60 min-h-[5rem] line-clamp-3">
      {data.description}
    </p>
  </div>
</div>
