---
import { Image } from 'astro:assets';

interface Props {
  img: ImageMetadata;
  imgAlt: string;
  title4: string;
  title5: string;
  description: string;
}

const { img, imgAlt, title4, title5, description } = Astro.props;
---


<div class="overflow-hidden w-fit">
  <Image 
    class="card-img h-auto w-full object-cover" 
    loading="lazy"
    src={img} 
    alt={imgAlt}
    widths={[400, 800, 1200]}
    sizes="100vw"
    format='webp'
  />
  
  <div class="px-2">
    <h4 class="card-title text-xl md:text-3xl font-serif italic text-gray-800">{title4}</h3>
    <h5 class="font-display text-4xl font-semibold mb-4 tracking-wide">{title5}</h5>
    <p class="text-floral-dark/80 text-base text-gray-600 leading-relaxed justify-center items-center tracking-wide">
      {description}
    </p>
  </div>
</div>


