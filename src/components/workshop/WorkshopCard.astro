---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';

interface Props {
  slug: string;
  imgSrc: string;
  imgAlt: string;
  title4: string;
  title5: string;
  description: string;
}

const { slug, imgSrc, imgAlt, title4, title5, description } = Astro.props;
---


<div id={slug} class="overflow-hidden w-fit">
  <OptimizedImage 
    class="card-img h-2/3 w-full object-cover"  
    src={imgSrc} 
    alt={imgAlt}  
    decoding="async" 
    loading="lazy" 
    sizes="(max-width: 768px) 100vw, 50vw"
  />
  
  <div class="px-2 py-4">
    <h3 class="card-title text-xl md:text-3xl font-serif italic text-gray-800">{title4}</h4>
    <h4 class="card-subtitle font-display text-4xl font-semibold mb-4 tracking-wide">{title5}</h5>
    <p class="card-description text-floral-dark/80 text-base text-gray-600 leading-relaxed justify-center items-center tracking-wide">
      {description}
    </p>
  </div>
</div>