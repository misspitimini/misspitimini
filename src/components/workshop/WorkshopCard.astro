---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';

interface Props {
  imgSrc: string;
  imgAlt: string;
  title4: string;
  title5: string;
  description: string;
}

const { imgSrc, imgAlt, title4, title5, description } = Astro.props;
---


<div class="overflow-hidden w-fit">
  <img class="card-img h-2/3 w-full object-cover"  src={imgSrc} alt={imgAlt}  decoding="async" loading="lazy" />
  
  <div class="px-2">
    <h4 class="card-title text-xl md:text-3xl font-serif italic text-gray-800">{title4}</h3>
    <h5 class="card-subtitle font-display text-4xl font-semibold mb-4 tracking-wide">{title5}</h5>
    <p class="card-description text-floral-dark/80 text-base text-gray-600 leading-relaxed justify-center items-center tracking-wide">
      {description}
    </p>
  </div>
</div>