---
import OptimizedImage from "@/components/commons/OptimizedImage.astro";
import tallerOtoñoBuffet from '@/assets/images/body/experiencias/tallerOtoñoBuffet.jpg';

const {  disable } = Astro.props;
const mostrar = (disable == null || disable == "false" );
---

<script type="application/ld+json">
	{{
		"@context": "https://schema.org",
		"@type": "Event",
		"name": "Corona de Otoño & Desayuno Buffet",
		"description": "Una experiencia creativa en la que aprenderás a crear tu propia corona de otoño, explorando las flores, los follajes y los elementos más bonitos de esta época del año.",
		"startDate": "2026-10-24T11:00-05:00",
		"endDate": "2026-10-24T13:30-05:00",
		"location": {{
			"@type": "Place",
			"name": "Espacio por confirmar",
			"address": {{
				"@type": "PostalAddress",
				"addressLocality": "Madrid",
				"addressCountry": "ES"
			}}
		}},
		"image": [tallerOtoñoBuffet.src],
		"offers": {{
			"@type": "Offer",
			"price": "105",
			"priceCurrency": "EUR",
			"availability": "https://schema.org/InStock",
			"url": "/solicitaPresupuesto/taller01"
		}},
		"organizer": {{
			"@type": "Organization",
			"name": "misspitimini",
			"url": "https://misspitimini.com"
		}}
	}}
</script>
<section id="taller01" class="space-y-10 py-10 bg-gray-100">
  <div class="space-y-4">
    <h3 class="font-serif text-4xl md:text-5xl  tracking-tight leading-tight italic mb-3 text-amber-800">
			 Corona de Otoño & Desayuno Buffet
	 </h3>
   <p class="card-date font-display text-2xl font-semibold mb-4 tracking-wide text-grey-600/60 text-center">Sábado 24 de octubre de 2026</p>
   <div class="card-title content-wrapper default-text-container">
    <p>
     Una experiencia creativa en la que aprenderás a crear <strong>tu propia corona de otoño</strong>, explorando las flores, los follajes y los elementos más bonitos de esta época del año.
    </p>
    </div>
	 <OptimizedImage 
   class="card-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
   src={tallerOtoñoBuffet}
   alt="imagen del evento" 
   decoding="async" 
   loading="lazy" 
   sizes="100vw"
    />
	 <div class="flex-1 text-center"> 

    <div class="card-title content-wrapper default-text-container">
      <p>
        Nos encontraremos en un <strong>espacio precioso de Madrid</strong>, especialmente elegido para esta experiencia, donde además disfrutaremos de un delicioso <strong>desayuno buffet</strong> preparado para la ocasión.
      </p>
      <p>
        Trabajaremos con follajes, flores y elementos propios de la temporada, seleccionados especialmente por su belleza y porque permiten un secado natural, para que puedas <strong></strong>conservar tu corona</strong> y disfrutarla durante mucho tiempo.
        <strong>Te guiaré</strong> paso a paso durante todo el proceso, compartiendo contigo técnicas y pequeños trucos para que puedas crear una  <strong>composición bonita</strong>, equilibrada y muy tuya.
      </p>
      <p>
        Yo facilitaré todos los materiales y herramientas necesarios, así que solo tendrás que <strong>venir, disfrutar y dejarte llevar</strong> por la creatividad.
        Y, por supuesto, <strong></strong>te llevarás a casa tu propia corona de otoño</strong>, creada por ti.
      </p>
      <p>
        Una experiencia cuidada al detalle en todos sus aspectos, pensada para quienes disfrutan de las flores, de las cosas bonitas y de esos momentos que hacen especial una mañana de otoño.
      </p>
      </div>

  {mostrar && (
    <br>
   <div  class="inset-0 flex items-end justify-center pb-[10px] md:pb-[54px]">
    <a 
      href="/solicitaPresupuesto/taller01" 
      class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all"
    >
      Reserva Ahora
    </a>
  </div>
  )}
 </div>
</section>
