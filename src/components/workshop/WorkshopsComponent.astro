---
import WorkshopCardNext from '@components/workshop/WorkshopCardNext.astro';
import WorkshopCard from '@components/workshop/WorkshopCard.astro';
import { getCollection } from 'astro:content';
import path from 'path';

// Search for images in all subdirectories
const allWorkshopImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');

const workshopEntries = await getCollection('workshops');

const workshops = await Promise.all(
  workshopEntries.map(async (workshop) => {
    const { data } = workshop;
    const slug = data.image;

    // Find the full path of the image that has the exact same name as the slug
    const imagePath = Object.keys(allWorkshopImages).find(fullPath => path.basename(fullPath) === slug);

    if (!imagePath) {
      throw new Error(`Image not found for workshop: \"${data.title4}\" with slug: \"${slug}\". Searched in all subdirectories of /src/assets/images/`);
    }

    const { default: image } = await allWorkshopImages[imagePath]();

    return {
      img: image,
      imgAlt: data.imgAlt,
      title4: data.title4,
      title5: data.title5,
      description: data.description
    };
  })
);
---

<section class="space-y-10 px-6">
  <div class="text-center space-y-2">
    <h2 class="text-3xl font-serif">Experiencias Florales y Gastronómicas</h2>
    <div class="h-px w-12 bg-primary mx-auto"></div>
  </div>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
    <div class="flex-1 text-center">
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Aprende a crear arreglos únicos y llenos de estilo con nuestros <strong>talleres presenciales</strong>, donde la estética floral y el placer culinario se encuentran en un mismo espacio.
        Esta no es solo una clase de diseño, es una invitación a transformar flores frescas en <strong>piezas de diseño</strong> mientras se deleita el paladar.
      </p>
      <br />
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        <strong>Sara Laínez</strong> propone una metodología donde la flor es la protagonista de un lenguaje visual propio. En sus talleres presenciales mayoritariamente en <strong>Madrid</strong>, Sara guía a los alumnos para que encuentren su propio estilo, huyendo de los arreglos rígidos y apostando por la naturalidad, el movimiento y la sostenibilidad.
      </p>
    </div>
  </div>
</section>

<section class="space-y-10">
  <h3 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide sm:pb-12 md:pb-12">
    Próximas experiencias:
  </h3>
</section>

<WorkshopCardNext />

<section class="space-y-10">
  <h3 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide sm:pb-12 md:pb-12">
    Otras experiencias:
  </h3>
</section>
<section class="space-y-10">
    <div class="grid gap-8 grid-cols-2">
      {workshops.map((workshop) => (
        <WorkshopCard
        img={workshop.img}
        imgAlt={workshop.imgAlt}
        title4={workshop.title4}
        title5={workshop.title5}
        description={workshop.description}
        />
      ))}
    </div>
</section>
