---
import WorkshopCardNext from "./WorkshopCardNext.astro";
import Form from "@/components/commons/Form.astro";
import WorkshopCardNextProv01 from "./WorkshopCardNextProv01.astro";
import WorkshopCardNextProv02 from "./WorkshopCardNextProv02.astro";
import WorkshopCardNextProv03 from "./WorkshopCardNextProv03.astro";

interface Props {
    taller: string;
}

const { taller } = Astro.props;
---
<section class="space-y-6">
    {taller === 'taller01' && <WorkshopCardNextProv01 disable={true} />}
    {taller === 'taller02' && <WorkshopCardNextProv02 disable={true} />}
    {taller === 'taller03' && <WorkshopCardNextProv03 disable={true} />} 
    <Form id={taller} />
</section>

