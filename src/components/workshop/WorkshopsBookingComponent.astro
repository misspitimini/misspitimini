---
import type { Workshop } from '@/types/Workshop';
import WorkshopCardNext from "./WorkshopCardNext.astro";
import Form from "@/components/commons/Form.astro";

interface Props {
    workshop: Workshop;
}
const { workshop } = Astro.props;

const isPastWorkshop = new Date(workshop.pubDate) < new Date();
const fecha = `${workshop.dateText} - ${workshop.hour}`;
    
---
<section class="space-y-6">
{isPastWorkshop && (
    <Form id="{workshop.slug}"
        title="{workshop.title}"
        fecha="{fecha}">
            <WorkshopCardNext workshop={workshop} isDisable={true} />
    </Form>
)}
{!isPastWorkshop && (
    <WorkshopCardNext workshop={workshop} isDisable={true} />
)}
</section>

