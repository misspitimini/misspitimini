---
import OptimizedImage from "@/components/commons/OptimizedImage.astro";
import { addHour } from "@/ts/utils";
import WorkshopElementDetail from '@/components/workshop/WorkshopElementDetail.astro';
import type { Workshop } from '@/types/Workshop';
import { marked } from 'marked';

interface Props {
    workshop: Workshop;
    isDisable?: boolean;
}
const { workshop, isDisable } = Astro.props;

const {
  slug,
  imgSrc,
  imgAlt,
  pubDate,
  dateText,
  hour,
  title,
  sumary: {
    duration,
    materials,
    experiences,
    price,
    location,
    capacity
  }, 
  pompadour,
  content
 } = workshop;

 const offersUrl = new URL(`/experiencias/${slug}/`, Astro.site ?? 'https://misspitimini.com').href;
 const pompadourHtml = pompadour ? await marked.parse(pompadour) : '';
 const contentHtml = content ? await marked.parse(content) : '';
 const datePart = new Date(pubDate).toISOString().slice(0, 10);
 const startTime = hour.replace(/\s*h$/i, '').trim();
 const durationMatch = duration.match(/[\d]+(?:[.,]\d+)?/);
 const endHour = addHour(startTime, Number(durationMatch?.[0].replace(',', '.') ?? 0));
 const startDate = `${datePart}T${startTime}:00+01:00`;
 const endDate = `${datePart}T${endHour}:00+01:00`;
 const priceMatch = price.match(/[\d]+(?:[.,]\d+)?/);
 const offerPrice = priceMatch ? Number(priceMatch[0].replace(',', '.')) : undefined;
 const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: title,
  description: pompadour,
  startDate,
  endDate,
  location: {
    "@type": "Place",
    name: location || 'Madrid',
    address: {
      "@type": "PostalAddress",
      addressLocality: 'Madrid',
      addressCountry: 'ES',
    },
  },
  image: imgSrc,
  offers: {
    "@type": "Offer",
    price: offerPrice,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: offersUrl,
  },
  organizer: {
    "@type": "Organization",
    name: 'misspitimini',
    url: 'https://misspitimini.com',
  },
 };
  const workshopDetails = [
  {
    value: `<strong>${dateText}</strong> · ${hour} h`,
    iconName: "calendar_month",
  },
  {
    value: `Duración: ~${duration} horas`,
    iconName: "timer",
  },
  {
    value: capacity,
    iconName: "groups",
  },
  {
    value: materials,
    iconName: "inventory_2",

  },
  {
    value: experiences,
    iconName: "emoji_events",
  },
  {
    value: location,
    iconName: "location_on",
  },
  {
    value: `<strong>${price} € por persona</strong>`,
    iconName: "euro",

  },
 ].filter(({ value }) => value !== '');
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
<section id={slug} class="space-y-10 py-10 bg-gray-100">
  <div class="space-y-4">
    <p class="font-display md:text-5xl font-semibold mb-4 tracking-wide text-grey-600/60 text-center">Próximo taller </p>
    <h3 class="font-serif text-4xl md:text-5xl  tracking-tight leading-tight italic mb-3 text-amber-800">
      {title}
	 </h3>
   <p class="card-date font-display text-2xl font-semibold mb-4 tracking-wide text-grey-600/60 text-center">{dateText}</p>
   <p class="card-date font-display text-2xl font-semibold mb-4 tracking-wide text-grey-600/60 text-center">{hour} h</p>
   <div class="card-title content-wrapper default-text-container">
    <div set:html={pompadourHtml}></div>
  </div>
	 <OptimizedImage 
   class="card-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
   src={imgSrc}
   alt="{imgAlt}" 
   decoding="async" 
   loading="lazy" 
   sizes="100vw"
    />
	 <div class="flex-1 text-center"> 
    <div class="flex justify-center w-full"> 
      <!-- Tarjeta de Detalles del Evento -->
       <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 py-4 border-y border-stone-100 text-sm">
       {workshopDetails.map((detail) => (
          <WorkshopElementDetail value={detail.value} iconName={detail.iconName} />
        ))}
        </div>
    </div>
    <div class="card-title content-wrapper default-text-container">
      <div set:html={contentHtml}></div>
    </div>

  {!isDisable && (
    <br>
   <div  class="inset-0 flex items-end justify-center pb-[10px] md:pb-[54px]">
    <a 
      href={offersUrl}
      class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all"
    >
      Reserva Ahora
    </a>
  </div>
  )}
  </div>
 </div>
</section>
