---
import OptimizedImage from "@/components/commons/OptimizedImage.astro";

interface Props {
  imgSrc: string;
  imgAlt: string;
  title4: string;
  title5: string;
  date:Date
  description: string;
}

const { imgSrc, imgAlt, title4, title5, date, description } = Astro.props;

const pubDate = (date).toLocaleDateString('es-ES', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
    });
---

<section class="space-y-10 py-10 bg-gray-100">
  <div class="space-y-4">
    <h3 class="font-display text-4xl font-semibold mb-4 tracking-wide text-red-600/60">Próximo taller</h3>
    <p class="card-date font-display text-4xl font-semibold mb-4 tracking-wide text-red-600/60 text-center">{pubDate}</p>
    <h4 class="card-title font-display text-4xl font-semibold mb-4 tracking-wide uppercase">{title4}</h4>
    <h5 class="card-subtitle font-display text-4xl font-semibold mb-4 tracking-wide">{title5}</h5>
    <p class="card-description text-floral-dark/80 text-base text-gray-600 leading-relaxed text-center tracking-wide">
      {description}
    </p>
    <div class="relative overflow-hidden shadow-sm group">
      <img class="card-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
        src={imgSrc}
        alt={imgAlt}  decoding="async" loading="lazy" />

      <div class="absolute inset-0 flex items-end justify-center pb-[10px] md:pb-[54px]">
        <a 
          href="/solicitaPresupuesto/" 
          class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all"
        >
          Solicitar presupuesto
        </a>
      </div>
    </div>
  </div>
</section>