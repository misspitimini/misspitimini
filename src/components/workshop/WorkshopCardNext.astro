---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry } from 'astro:content';

// Fetch the content entry for the next workshop. 
const nextWorkshop = await getEntry('nextworkshop', 'proxima-experiencia');

// Handle the case where the entry is not found.
if (!nextWorkshop) {
  throw new Error(
    "The content entry for 'proxima-experiencia' was not found in the 'next-workshop' collection. Please ensure the file exists at 'src/content/next-workshop/proxima-experiencia.json'."
  );
}

// Now that we've checked, TypeScript knows nextWorkshop is defined.
const { imgAlt, date, title4, title5, description, image } = nextWorkshop.data;

// Correctly type the glob import: the resolved module has a `default` property.
const allWorkshopImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');

const imagePath = `/src/assets/images/body/experiencias/${image}`;

if (!allWorkshopImages[imagePath]) {
  throw new Error(`Image not found: ${imagePath}. Check the image name in proxima-experiencia.json and ensure it exists.`);
}

// Use destructuring to get the default export, which is the ImageMetadata object.
const { default: imageSrc } = await allWorkshopImages[imagePath]();
---

<section class="space-y-10 border border-slate-300 pt-4">
  <div class="space-y-4">
    <h3 class="font-display text-4xl font-semibold mb-4 tracking-wide text-red-600/60">Próximo taller</h3>
    <p class="font-display text-4xl font-semibold mb-4 tracking-wide text-red-600/60">{date}</p>
    <h4 class="font-display text-4xl font-semibold mb-4 tracking-wide uppercase">{title4}</h4>
    <h5 class="font-display text-4xl font-semibold mb-4 tracking-wide">{title5}</h5>
    <p class="text-floral-dark/80 text-base text-gray-600 leading-relaxed justify-center items-center tracking-wide">
      {description}
    </p>
    <div class="relative overflow-hidden shadow-sm group">
      <Image 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" 
        loading="lazy" 
        src={imageSrc} 
        alt={imgAlt}
        widths={[400, 800, 1200]}
        sizes="100vw"
        format='webp'
      />
      <div class="absolute inset-0 flex items-end justify-center pb-[10px] md:pb-[54px]">
        <a 
          href="/solicitaPresupuesto/" 
          class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all"
        >
          Solicitar presupuesto
        </a>
      </div>
    </div>
  </div>
</section>