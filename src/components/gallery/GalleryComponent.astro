---
import galleryData from "@data/gallery.json";
import GalleryCard from './GalleryCard.astro';

// Define la estructura de una entrada de la galería para TypeScript
interface GalleryEntry {
  imgSrc: string;
  imgAlt: string;
  title: string;
  description: string;
  link: string;
}

// Asigna el tipo al JSON importado para que TypeScript conozca su estructura
const galleryEntries: GalleryEntry[] = galleryData;
---
<section class="space-y-10">
  <div class="text-center space-y-2 px-6">
    <h2 class="text-3xl font-serif">Nuestros Recuerdos</h2>
    <div class="h-px w-12 bg-primary mx-auto"></div>
  </div>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4 px-6">
    <div class="flex-1 text-center">
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Hay palabras que solo las flores saben decir. <strong>Nuestra galería</strong> es un recorrido por las emociones que hemos ayudado a cultivar. Desde <strong>bodas</strong> en en tonos pastel, hasta la energía vibrante de un <strong>taller</strong> en colores cítricos. Cada pétalo aquí presente cuenta una historia; <strong>te invitamos a encontrar la tuya</strong>.
      </p>
    </div>
  </div>
  <div id="gallery-container" class="columns-2 gap-4 space-y-4">
      {galleryEntries.map((gallery) => (
        <GalleryCard
          imgSrc={gallery.imgSrc}
          imgAlt={gallery.imgAlt}
          title={gallery.title}
          description={gallery.description}
          link={gallery.link}
        />
      ))}
  </div>
</section>
<template id="card-gallery-template" class="hidden">
  <GalleryCard
    imgSrc=""
    imgAlt=""
    title=""
    description=""
    link=""
  />
</template>
