---
const projects = [
    {
        image: "https://via.placeholder.com/800x600/FDF5EA/FDF5EA",
        title: "Romantic Wedding Bouquet",
        description: "A stunning arrangement of roses, peonies, and eucalyptus."
    },
    {
        image: "https://via.placeholder.com/800x600/FDF5EA/FDF5EA",
        title: "Vibrant Summer Centerpiece",
        description: "A colorful mix of seasonal flowers to brighten any table."
    },
    {
        image: "https://via.placeholder.com/800x600/FDF5EA/FDF5EA",
        title: "Elegant Orchid Arrangement",
        description: "A sophisticated display of white orchids for a modern aesthetic."
    },
    {
        image: "https://via.placeholder.com/800x600/FDF5EA/FDF5EA",
        title: "Whimsical Wildflower Crown",
        description: "A delicate and ethereal crown for a special occasion."
    }
];
---

<section id="projects" class="py-20 bg-[#FDF5EA]">
    <div class="container mx-auto px-4">
        <h2 class="text-4xl font-bold font-serif text-center mb-12 text-[#2c3e50]">Our Projects</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {projects.map(project => (
                <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                    <img src={project.image} alt={project.title} class="w-full h-64 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold font-serif text-[#2c3e50] mb-2">{project.title}</h3>
                        <p class="text-[#2c3e50]">{project.description}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>