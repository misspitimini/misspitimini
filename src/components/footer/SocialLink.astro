---
import Icon from '@/components/commons/Icon.astro';
import { ICONS, type Platform } from '@/data/socials';

interface Props {
  platform: Platform;
  label: string;
}

const { platform, label} = Astro.props;

const iconData = ICONS[platform];

---

<a 
  href={iconData.href} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="group flex flex-col items-center transition-all duration-300 hover:scale-110"
>
  <span class="sr-only">{label || platform}</span>
  <div class="p-2 rounded-full group-hover:text-primary-grey transition-colors">
    <Icon {...iconData}  />
  </div>
</a>
