---
import { Image } from 'astro:assets';
import SocialNetworks from '@components/footer/SocialNetworks.astro';
import logo from '@assets/images/logos/logo_10.jpg';
const currentYear = new Date().getFullYear();
---

<footer>
    <div class="pt-8"></div>
    <a href="#" target="_self" rel="noopener noreferrer" class="inline-flex items-center">
        <Image src={logo} alt="Logotipo de Misspitimini" class="h-6 w-auto object-contain" widths={[100, 200]} formats={['avif', 'webp']} />
    </a>
    </div>
    <SocialNetworks />

    <div class="flex flex-col items-center gap-2 border-t border-gray-100 pt-6">
        <p class="text-lg font-serif italic text-gray-800">
            misspitimini <span class="text-gray-400 font-sans not-italic text-sm mx-2">|</span> Madrid
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-tighter">
            &copy; {currentYear} &bull; Hecho con flores y detalles
        </p>
    </div>
</footer>