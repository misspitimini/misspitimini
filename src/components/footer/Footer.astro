---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';
import SocialNetworks from '@/components/footer/SocialNetworks.astro';
import logo from '@/assets/images/logos/logo_10.jpg';
const currentYear = new Date().getFullYear();
---

<footer>
    <div class="py-8 text-center">
        <a href="/" class="inline-flex items-center">
            <OptimizedImage src={logo} alt="Logotipo de misspitimini" class="h-8 w-auto object-contain" width={200}  />
        </a>
    </div>

    <SocialNetworks />

    <div class="flex flex-col items-center gap-2 border-t border-gray-100 pt-6 mt-8">
        <p class="text-lg font-serif italic text-gray-800">
            misspitimini <span class="text-gray-400 font-sans not-italic text-sm mx-2">|</span> Madrid
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-tighter">
            &copy; {currentYear} &bull; Hecho con flores y detalles
        </p>
    </div>
</footer>
