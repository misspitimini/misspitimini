---

const nextWorkshop =
{
    imgSrc: "/images/body/talleres/ramosFlores.jpg",
    imgAlt: "Taller de ramos de flores",
    date: "7 de Marzo de 2026",
    title: "Ramos de Flores",
    description: "Aprende a crear ramos de flores únicos y personalizados, combinando colores, texturas y aromas.",
    link: "/workshops/flower-bouquets",
}
const { imgSrc, imgAlt, date, title, description, link } = nextWorkshop;
---
<section class="min-h-screen flex items-center justify-center p-4">
  <div class="relative p-[1px]  bg-gradient-to-br from-yellow-200 via-yellow-500 to-yellow-700 shadow-[0_0_20px_rgba(212,175,55,0.3)] transition-transform duration-300 hover:scale-105">
    <div class="shadow-soft-elevation">
      <img class="w-full h-56 object-cover" src={imgSrc} alt={imgAlt}>
      <div class="p-6">
        <h3 class="font-display text-4xl font-semibold  mb-4 tracking-wide text-red-600/60">Próximo taller</h3>
        <p class="font-display text-4xl font-semibold  mb-4 tracking-wide text-red-600/60">{date}</p>
        <h4 class="font-display text-4xl font-semibold  mb-4 tracking-wide">Taller "{title}"</h3>
        <p class="mt-2 text-base text-white">
          {description}
        </p>
        <div class="mt-4">
          <a href='/reservaTaller/' 
          class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95 uppercase">
          Reservar asistencia
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

