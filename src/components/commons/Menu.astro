---
---
<div class="flex flex-col max-w-screen-xl px-4 mx-auto md:items-center md:justify-between md:flex-row md:px-6 lg:px-8;">
    <nav :class="{'flex': open, 'hidden': !open}" class="flex-col flex-grow pb-4 md:pb-0 hidden md:flex md:justify-end md:flex-row">
      <a href="/" @click="activeSlide = 1" class="px-4 py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold" :class="{ 'font-bold': activeSlide === 1 }" href="">
	  Inicio
	  <span class="invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Inicio</span>
	  </a>
      <a @click="activeSlide = 2" class="px-4 py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold" :class="{ 'font-bold': activeSlide === 2 }" href="/events/">
	  Bodas y Eventos
	  <span class="invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Bodas y Eventos</span>
	  </a>
      <a  @click="activeSlide = 3" class="px-4 py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold" :class="{ 'font-bold': activeSlide === 3 }" href="/workshops/">
	  Talleres
	  <span class="invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Cursos</span>
	  </a>
      <a @click="activeSlide = 4" class="px-4 py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold" :class="{ 'font-bold': activeSlide === 4 }" href="/bouquets/">
	  Ramos Personalizados
	  <span class="invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Ramos Personalizados</span>
	  </a>
      <a @click="activeSlide = 5" class="px-4 py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold" :class="{ 'font-bold': activeSlide === 5 }" href="/blog/">
	  Blog
	  <span class="invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Blog</span>
	  </a>      
    </nav>
  </div>