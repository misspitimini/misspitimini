---
---
<div class="fixed top-0 left-0 right-0 z-50 md:relative md:top-auto md:z-auto flex flex-col max-w-screen-xl px-4 mx-auto md:items-center md:justify-between md:flex-row md:px-6 lg:px-8">

	<nav :class="{'flex': open, 'hidden': !open}" 
		 class="flex-col flex-grow pb-4 md:pb-0 hidden md:flex md:justify-end md:flex-row bg-white/95 backdrop-blur-md md:bg-transparent md:backdrop-blur-none shadow-lg md:shadow-none border-b md:border-none">
		 <div x-show="open" class="p-4 my-8 flex flex-row items-start justify-end">
			<button class="md:hidden rounded-lg focus:outline-none focus:shadow-outline" @click="open = !open">
			  <svg fill="currentColor" viewBox="0 0 20 20" class="w-6 h-6">
				 <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
			  </svg>
			</button>
			
		</div>
	  <a href="/" @click="activeSlide = 1" 
		 class="font-display px-4 py-3 md:py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold transition-all" 
		 :class="{ 'font-bold text-black': activeSlide === 1, 'text-gray-600': activeSlide !== 1 }">
		Inicio
		<span class="font-display invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Inicio</span>
	  </a>
  
	  <a @click="activeSlide = 2" 
		 class="font-display px-4 py-3 md:py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold transition-all" 
		 :class="{ 'font-bold text-black': activeSlide === 2, 'text-gray-600': activeSlide !== 2 }" 
		 href="/events/">
		Bodas y Eventos
		<span class="font-display invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Bodas y Eventos</span>
	  </a>
  
	  <a @click="activeSlide = 3" 
		 class="font-display px-4 py-3 md:py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold transition-all" 
		 :class="{ 'font-bold text-black': activeSlide === 3, 'text-gray-600': activeSlide !== 3 }" 
		 href="/workshops/">
		Talleres
		<span class="font-display invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Talleres</span>
	  </a>
  
	  <a @click="activeSlide = 4" 
		 class="font-display px-4 py-3 md:py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold transition-all" 
		 :class="{ 'font-bold text-black': activeSlide === 4, 'text-gray-600': activeSlide !== 4 }" 
		 href="/bouquets/">
		Ramos
		<span class="font-display invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Ramos</span>
	  </a>
  
	  <a @click="activeSlide = 5" 
		 class="font-display px-4 py-3 md:py-2 mt-2 text-sm bg-transparent md:mt-0 md:ml-4 hover:font-bold transition-all" 
		 :class="{ 'font-bold text-black': activeSlide === 5, 'text-gray-600': activeSlide !== 5 }" 
		 href="/blog/">
		Blog
		<span class="font-display invisible block h-0 overflow-hidden font-bold" aria-hidden="true">Blog</span>
	  </a>      
	</nav>

  </div>
