---
interface FAQ {
  pregunta: string;
  respuesta: string;
}

interface Props {
  faqs: FAQ[];
  title?: string;
  subtitle?: string;
}

const { faqs, title, subtitle } = Astro.props;
---

<section class="py-12 md:py-20 bg-white">
  <div class="max-w-3xl mx-auto px-4">
    {title && <h2 class="text-3xl font-bold text-center mb-2">{title}</h2>}
    {subtitle && <p class="text-center text-gray-600 mb-8">{subtitle}</p>}
    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="p-4 rounded-lg shadow-sm group">
          <summary class="font-semibold cursor-pointer flex justify-between items-center">
            <span>{faq.pregunta}</span>
            <span class="transform transition-transform duration-300 group-open:rotate-180">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="mt-4 text-gray-700">
            <p>{faq.respuesta}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
