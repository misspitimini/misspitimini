---
import { Image } from 'astro:assets';
import type { ComponentProps } from 'astro/types';

// Combinamos las props del componente `Image` de Astro con los atributos HTML estándar de una imagen.
// Esto asegura que nuestro componente acepte `class` y otros atributos HTML.
type Props = ComponentProps<typeof Image>;

const { ...props } = Astro.props;

if (!props.src || !props.alt) return null;
---

<!-- 
  Pasamos nuestras props por defecto primero, y luego las que recibe el componente.
  Esto permite que si se pasa un `loading` o `format` personalizado, sobreescriba nuestros valores por defecto.
-->
<Image
  decoding="async" 
  loading="lazy" 
  format='webp'
  {...props} 
/>
