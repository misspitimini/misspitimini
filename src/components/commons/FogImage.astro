---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata | string;
    alt: string;
    sizes?: string;
    class?: string;
    [key: string]: any; // Allow other props
}

const { src, alt, sizes, class: className, ...rest } = Astro.props;
---

<div class="relative overflow-hidden">
    <OptimizedImage 
        src={src} 
        alt={alt} 
        sizes={sizes}
        class:list={[className]}
        {...rest} 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-white via-white/50 to-white opacity-30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-white via-transparent to-white opacity-30"></div>
</div>