---
import type { HTMLAttributes } from 'astro/types';
import PrivacyPolicy from '@/components/commons/PrivacyPolicy.astro';

interface Props extends HTMLAttributes<'form'> {
  id?: string;
  title?: string;
  fecha?: string;
}

const {title, fecha} = Astro.props;

---
    <slot />
    <!--SectionTitle>Solicita presupuesto para disfrutar de tu expericia con ramos florales</SectionTitle-->
    <h2 class="font-display text-4xl font-semibold text-gray-900 mb-4 mx-auto px-2 tracking-wide pb-0 sm:pb-12 md:pb-12">
      Datos necesarios para comenzar a disfrutar de esta experiencia floral:
     </h2>
     <div class="flex justify-center w-full">
    <div class="max-w-5xl md:px-10 text-justify text-floral-dark/80 leading-relaxed space-y-4">
      <form id="formularioReserva" class="w-full" novalidate>
        <div class="flex-1 text-center mx-1">
        <input type="hidden" id="titulo_taller" name="titulo_taller" value={fecha} />
        <input type="hidden" id="fecha" name="fecha" value={fecha} />
        <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-0">
            <label for="nombre" class="block text-[#2c3e50] mb-2">Nombre y Apellidos (*):</label>
            <input type="text" id="nombre" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black">
            <div
            id="error-nombre"
            class="hidden items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
            role="alert" >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
            <div style="display:none !important; visibility:hidden !important; position:absolute !important; left:-9999px !important;" aria-hidden="true">
              <label for="website">Apellidos:</label>
              <input type="text" id="apellidos" name="apellidos" tabindex="-1" autocomplete="off" value="Apellidos">
            </div>
          </div>
        </p>
        <br />
        <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-0">
          <label for="telefono" class="block text-[#2c3e50] mb-2">Teléfono / WhatsApp (*):</label>
          <input type="tel" id="telefono" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black">
          <div
          id="error-telefono"
          class="hidden items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
          role="alert" >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
        </div>
        </p>
        <br />
        <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-0">
            <label for="email" class="block text-[#2c3e50] mb-2">Email (*):</label>
            <input type="email" id="email" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black">
            <div
          id="error-email"
          class="hidden items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
          role="alert" >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
          <!-- Ht 2:  -->
          <div style="opacity: 0; position: absolute; top: 0; left: 0; height: 0; width: 0; z-index: -1; overflow: hidden;" aria-hidden="true">
            <label for="confirm_email">Confirme su Email (dejar vacío):</label>
            <input type="email" id="confirm_email" name="confirm_email" tabindex="-1" autocomplete="off">
          </div>
        </div>
        </p>
        <br />
        <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-0">
            <label for="numero_plazas" class="block text-[#2c3e50] mb-2">Número de plazas (*):</label>
            <div class="flex items-center justify-center">
                <button type="button" id="decrease" class="bg-black text-white font-bold py-3 px-5 rounded-l-full hover:bg-gray-800 transition-transform active:scale-95">-</button>
                <input type="number" id="numero_plazas" class="w-20 text-center py-3 border-t border-b border-gray-300 focus:outline-none focus:border-black" min="1" value="1">
                <button type="button" id="increase" class="bg-black text-white font-bold py-3 px-5 rounded-r-full hover:bg-gray-800 transition-transform active:scale-95">+</button>
            </div>
            <div
                id="error-numero_plazas"
                class="hidden items-center justify-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
                role="alert" >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-medium italic">Este campo es obligatorio y debe ser mayor que 0.</span>
            </div>
        </p>
        <br />
        <div id="additional-attendees-container"></div>
        <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-0">
            <label for="es_regalo" class="inline-flex items-center gap-2 text-[#2c3e50] mb-2">
                <span>¿Es un regalo?</span>
            </label>
            <input type="checkbox" id="es_regalo" class="h-6 w-6 border border-gray-300 focus:outline-none focus:border-black">
        </p>
        <div class="max-w-5xl mx-auto px-2 md:px-10 text-justify text-floral-dark/80 leading-relaxed space-y-4 italic">
          <p>
            Puedes indicarlo en las observacones al realizar tu reserva y prepararemos una tarjeta regalo digital personalizada, que recibirás por email para que puedas imprimirla y entregársela a esa persona especial.
            Una forma bonita de regalar flores, creatividad y una experiencia para recordar.
          </p>
        </div>

        <br />
        <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-0">
            <label for="mensaje" class="block text-[#2c3e50] mb-2">Observacones:</label>
            <textarea id="mensaje" rows="5" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black"></textarea>
            <div
            id="error-mensaje"
            class="hidden items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
            role="alert" >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
          </div>
        </p>
        </div>
        <h3 class="font-display text-2xl font-semibold text-gray-900 mb-4 mx-auto px-2 tracking-wide pb-0 sm:pb-12 md:pb-12">
          Condiciones
        </h3>
        <div class="ml-3 items-start italic"> 

          <p>
            Una vez enviada la solicitud, recibirás un correo electrónico de control. Posteriormente, contactaremos contigo por el medio que nos hayas indicado.
          </p>
          <p>La reserva del taller no es reembolsable.</p>
          <p>Si finalmente no puedes asistir, puedes ceder tu plaza a otra persona, avisándome previamente.</p>
          <p>Las cancelaciones deberán comunicarse con 72 horas de antelación. En ese caso, se facilitará un bono por el importe de la reserva para utilizar en otro taller misspitimini, sujeto a disponibilidad.</p>
      </div>


        <PrivacyPolicy>
          <div class="flex flex-row justify-center items-center gap-6 my-8 w-full">
            <input type="hidden" id="form_timestamp" name="form_timestamp">
          
            <button type="submit" class="bg-black text-white font-bold py-3 px-8 rounded-full uppercase">
              Enviar solicitud
            </button>
          
            <a href="/experiencias/" class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95">
              Volver
            </a>
          </div>
        </PrivacyPolicy>
      </form>
      <div x-data="{ openSuccess: false }" @abrir-modal-success.window="openSuccess = true">
      <div 
      x-show="openSuccess" 
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-cloak
      style="display:none">
      <div id="message-success"
        @click.away="openSuccess = false" 
        class="bg-white w-full max-w-2xl  shadow-2xl flex flex-col max-h-[80vh]"
      role="alert" >
        <div class="p-6 border-b border-slate-100 flex justify-between items-center">
          <h4 class="text-xl font-bold text-slate-800">Enviada Solicitud</h4>
        </div>
        <div
        class="mx-6 flex items-center gap-2 p-2.5 mt-2 text-green-700 bg-green-50 border border-green-200 rounded-md transition-all duration-200 ease-in-out"
        >
        <div class="m-6 flex-shrink-0 text-green-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <span class="text-sm font-medium whitespace-pre-line text-center"></span>
        </div>
        <div class="p-6 overflow-y-auto text-slate-600 text-sm leading-relaxed space-y-4">
          <p class="font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">Una vez enviada la solicitud, recibirás un correo electrónico de control. Posteriormente, contactaremos contigo por el medio que nos hayas indicado.</p>
      
        <div class="p-6 border-t border-slate-100  rounded-b-2xl flex justify-center">
          <div class="text-center">
            <button @click="openSuccess = false;" type="button" class="bg-black text-white font-bold py-3 px-8 rounded-full">Cerrar</button>
          </div>
        </div>
      </div>
    </div>
      </div>
      </div>  
  <script src="/src/ts/numberPlaces.ts"></script>
