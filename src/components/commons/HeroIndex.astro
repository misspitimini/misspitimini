---
interface Props {
    activeSlide: number;
    href: string;
}
const { activeSlide, href} = Astro.props;

const slides = [
		{ id: 1, title: 'Home', description:'Home', url: '/home/', img: '/images/carrusel/01_misspitimini.jpg', phrase: 'Disfruta de la magia de las flores' },
		{ id: 2, title: 'Bodas', description:'Bodas', url: '/bodas/', img: '/images/carrusel/02_ceremoniaBoda.jpg', phrase: 'Haciendo florecer tus mejores recuerdos' },
		{ id: 3, title: 'Eventos', description:'Eventos', url: '/eventos/', img: '/images/carrusel/03_eventos.jpg', phrase: 'Aportando frescura en un entorno profesional' },
		{ id: 4, title: 'Experiencias', description:'Talleres: Experiencias Florales y Gastronómicas', url: '/experiencias/', img: '/images/carrusel/04_cursoFlores.jpg', phrase: 'Aprendiendo de las flores' },
		{ id: 5, title: 'Galería', description:'Galería',  url: '/galeria/', img: '/images/carrusel/05_ramosFlores.jpg', phrase: 'Cada flor, una memorias que florece' },
		{ id: 6, title: 'Contacto', description:'Contacto', url: '/contacto/', img: '/images/carrusel/06_contacto.jpg', phrase: 'Compartamos la pasión por lo natural' },
		{ id: 7, title: 'Blog', description:'Blog', url: '/blog/', img: '/images/carrusel/07_blog.jpg', phrase: 'Compartir experiencias con las flores' }
	];

const currentSlide = slides[activeSlide - 1] || slides[0];
---
<section class="relative h-[85vh] w-full overflow-hidden">
  <div class="absolute inset-0">
    <img alt={currentSlide.phrase} class="h-full w-full object-cover object-center" decoding="async" loading="eager" src={currentSlide.img}/>
  </div>
  <div class="absolute inset-0 bg-black/10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
  <div class="absolute inset-0 flex flex-col justify-end p-8 pb-20 text-center items-center">
        <h1 class="text-white text-4xl font-serif italic leading-tight mb-8">
          {currentSlide.id === 1 && (
            <span>Sara Laínez,<br/>diseñadora floral</span>
          )}
          {currentSlide.id !== 1 && (
            <>
              <span class="uppercase">{currentSlide.title}</span>
              <span class="block text-sm tracking-widest mt-2">
                {currentSlide.phrase}
              </span>
            </>
          )}
        </h1>
        {currentSlide.id !== 4 && currentSlide.id !== 6 && (
          <>
            <a 
              href="/contacto/" 
              class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all"
            >
              Contacta conmigo
            </a>
          </>
        )}

  </div>
  </section>