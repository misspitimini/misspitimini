---
interface Props {
    activeSlide: number;
    href: string;
}
const { activeSlide, href} = Astro.props;

const slides = [
		{ id: 1, title: 'Home', description:'Home', url: '/', img: '/images/carrusel/01_misspitimini.jpg', phrase: 'Disfruta de la magia de las flores' },
		{ id: 2, title: 'Bodas', description:'Bodas', url: '/bodas/', img: '/images/carrusel/02_ceremoniaBoda.jpg', phrase: 'Haciendo florecer tus mejores recuerdos' },
		{ id: 3, title: 'Eventos', description:'Eventos', url: '/eventos/', img: '/images/carrusel/03_eventos.jpg', phrase: 'Aportando frescura en un entorno profesional' },
		{ id: 4, title: 'Experiencias', description:'Talleres: Experiencias Florales y Gastronómicas', url: '/experiencias/', img: '/images/carrusel/04_cursoFlores.jpg', phrase: 'Aprendiendo de las flores' },
		{ id: 5, title: 'Galería', description:'Galería',  url: '/galeria/', img: '/images/carrusel/05_ramosFlores.jpg', phrase: 'Cada flor, una memorias que florece' },
		{ id: 6, title: 'Contacto', description:'Contacto', url: '/contacto/', img: '/images/carrusel/06_contacto.jpg', phrase: 'Compartamos la pasión por lo natural' },
		{ id: 7, title: 'Blog', description:'Blog', url: '/blog/', img: '/images/carrusel/07_blog.jpg', phrase: 'Compartir experiencias con las flores' }
	];

const currentSlide = slides[activeSlide - 1] || slides[0];

// Encontramos el índice actual en el array (0 a 6)
const currentIndex = slides.findIndex(s => s.id === activeSlide);

// Lógica Circular:
// Si es el primero, el anterior es el último. Si es el último, el siguiente es el primero.
const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
const nextIndex = (currentIndex + 1) % slides.length;

const prevUrl = slides[prevIndex].url;
const nextUrl = slides[nextIndex].url;

---
<section class="relative h-[85vh] w-full overflow-hidden">
  <div class="absolute inset-0">
    <img alt={currentSlide.phrase} class="h-full w-full object-cover object-center" decoding="async" loading="eager" src={currentSlide.img}/>
  </div>
  <div class="absolute inset-0 bg-black/10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
  <div class="absolute inset-0 flex flex-col justify-end p-12 md:p-8 pb-15 text-center items-center">
        <h1 class="text-white text-4xl font-serif italic leading-tight mb-8">
          {currentSlide.id === 1 && (
            <span>Sara Laínez,<br/>diseñadora floral</span>
          )}
          {currentSlide.id !== 1 && (
            <>
              <span class="uppercase">{currentSlide.title}</span>
              <span class="block text-sm md:text-lg tracking-widest mt-2">
                {currentSlide.phrase}
              </span>
            </>
          )}
        </h1>
        {currentSlide.id !== 4 && currentSlide.id !== 6 && (
          <>
            <a 
              href="/contacto/" rel="noopener noreferrer" 
              class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all"
            >
              Contacta conmigo
            </a>
          </>
        )}

  </div>
  </section>
  <div class="flex items-center justify-between w-full md:hidden">
    <a 
      href={prevUrl} 
      aria-label="Anterior" 
      class="material-symbols-outlined text-primary p-2 hover:bg-black/5 rounded-full transition-colors"
    >
      arrow_back
    </a>
  
    <a 
      href={nextUrl} 
      aria-label="Siguiente" 
      class="material-symbols-outlined text-primary p-2 hover:bg-black/5 rounded-full transition-colors"
    >
      arrow_forward
    </a>
  </div>
  <script define:vars={{ prevUrl, nextUrl }}>
    let touchstartX = 0;
    let touchendX = 0;
      
    // Umbral mínimo para que se considere "deslizar" y no un simple toque (en píxeles)
    const threshold = 70;
  
    function handleGesture() {
      if (touchendX < touchstartX - threshold) {
        // Deslizó a la izquierda -> Ir a Siguiente
        window.location.href = nextUrl;
      }
      if (touchendX > touchstartX + threshold) {
        // Deslizó a la derecha -> Ir a Anterior
        window.location.href = prevUrl;
      }
    }
  
    // Escuchar eventos en el documento o en un contenedor específico
    document.addEventListener('touchstart', e => {
      touchstartX = e.changedTouches[0].screenX;
    }, { passive: true });
  
    document.addEventListener('touchend', e => {
      touchendX = e.changedTouches[0].screenX;
      handleGesture();
    }, { passive: true });
  </script>

