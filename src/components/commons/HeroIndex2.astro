---

---

<section class="space-y-10">
  <div class="text-center space-y-2">
  <h2 class="text-3xl font-serif">Experiencias Florales y Gastronómitas</h2>
  <div class="h-px w-12 bg-primary mx-auto"></div>
  </div>
  <div class="space-y-12">
    <div class="space-y-4">
      <div class="relative rounded-3xl overflow-hidden shadow-sm group">
        <img 
          alt="Talleres Misspitimini:Esta imagen muestra el proceso de trabajo detrás de los detalles florales." 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" 
          loading="lazy" 
          src="/images/carrusel/04_cursoFlores.jpg"
        />
        <div class="absolute inset-0 flex items-end justify-center pb-[10px] md:pb-[54px]">
          <a 
          href="/experiencias/" 
          class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all"
            > Información y Resumen
          </a>
        </div>
      </div>
      <div class="flex justify-between items-center">
        <h3 class="text-xl md:text-3xl font-serif italic text-gray-800">Talleres Florales</h3>
        <span class="material-symbols-outlined text-primary">arrow_forward</span>
      </div>
      <div class="flex justify-between items-center">
        <p class="text-[16px] text-floral-dark/60">Aprendiendo de las flores</p>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-6">
      <div class="space-y-4">
      <div class="aspect-square rounded-2xl overflow-hidden">
        <a href="/bodas/" rel="noopener noreferrer">
            <img alt="Una escena romántica a la salida de una ceremonia de boda. a lleva un vestido de novia blanco satinado con escote de hombros caídos, un velo y un ramo de flores blancas y hojas verdes. Él viste un esmoquin negro clásico con pajarita." class="w-full h-full object-cover" loading="lazy" src="/images/carrusel/02_ceremoniaBoda.jpg"/>
        </a>
         </div>
      <h3 class="text-xl md:text-3xl font-serif italic text-gray-800">
        <a href="/bodas/" rel="noopener noreferrer">Bodas</a>
      </h3>
      <p class="text-[16px] text-floral-dark/60">Haciendo florecer tus mejores recuerdos</p>
      </div>
      <div class="space-y-4">
      <div class="aspect-square rounded-2xl overflow-hidden">
      <a href="/eventos/" rel="noopener noreferrer">
          <img alt="Un buffet o mesa de presentación muy detallada de un evento o tienda gourmet" class="w-full h-full object-cover" loading="lazy" src="/images/carrusel/03_eventos.jpg"/>
      </a>
      </div>
      <h3 class="text-xl md:text-3xl font-serif italic text-gray-800">
        <a href="/eventos/" rel="noopener noreferrer">Eventos</a>
      </h3>
      <p class="text-[16px] text-floral-dark/60">Aportando frescura en un entorno profesional</p>
      </div>
    </div>
  </div>
  </section>