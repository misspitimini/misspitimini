  "telephone": "+34684340769",
  "email": "hola@misspitimini.com",
  "url": Astro.url.href,
  "image": new URL("/misspitimini.jpg", Astro.url).href,
  "founder": {
    "@type": "Person",
    "name": "Sara Laínez",
    "jobTitle": "Diseñadora Floral",
    "url": "https://misspitimini.com/sobre-mi/",
    "knowsAbout": [
    "Diseño floral",
    "Bodas",
    "Eventos corporativos",
    "Experiencias florales",
