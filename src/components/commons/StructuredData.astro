
---
interface Props {
    schema?: any; // Allow passing a specific schema object
}

const { schema } = Astro.props;

// Default business data if no specific schema is provided
const defaultBusinessData = {
  "@context": "https://schema.org",
  "@type": "Florist",
  "name": "misspitimini, floral Design by Sara Laínez",
  "description": "misspitimini es el proyecto de Sara Laínez, diseñadora floral en Madrid. Ofrecemos diseño floral para eventos, talleres y experiencias únicas con flores.",
  "telephone": "+34684340789",
  "email": "hola@misspitimini.com",
  "url": Astro.site ? Astro.site.toString() : "https://misspitimini.com",
  "image": new URL("/misspitimini.jpg", Astro.site).href,
  "openingHours": "Mo-Su 00:00-23:59",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Madrid",
    "addressCountry": "ES"
  },
  "areaServed": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": "40.416775",
      "longitude": "-3.703790"
    },
    "geoRadius": "40000"
  },
  "sameAs": [
    "https://www.facebook.com/misspitimini/?locale=es_ES",
    "https://www.tiktok.com/@misspitimini_official?hl=es",
    "https://www.instagram.com/misspitimini_official/?hl=es"
  ]
};

const finalSchema = schema || defaultBusinessData;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
