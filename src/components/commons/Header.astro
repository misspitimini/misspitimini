---
import Carrusel from "./Carrusel.astro";
import Menu from "./Menu.astro";

---

<header class="bg-white p-0 shadow-soft-elevation border border-gray-50 text-center">
	<div x-data="{ open: false, activeSlide: 1, slides: [1, 2, 3, 4, 5] }" >
    <div class="flex justify-center">
        <a href="#" target="_self" rel="noopener noreferrer">
            <img src="./images/logos/logo.png" alt="Logotipo" class="w-100 md:w-1/3 h-auto">
        </a>
            <div x-show="!open" class="p-4 my-8 flex flex-row items-start justify-between">
                <button class="md:hidden rounded-lg focus:outline-none focus:shadow-outline" @click="open = !open">
                <svg fill="currentColor" viewBox="0 0 20 20" class="w-8 h-8">
                <path  fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM9 15a1 1 0 011-1h6a1 1 0 110 2h-6a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                </svg>
                </button>
            </div>
    </div>
    <Menu />
    <Carrusel />
    </div>
</header>