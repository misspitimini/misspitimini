---
import Carrusel from "./Carrusel.astro";
import Menu from "./Menu.astro";

---

<header class="bg-white p-0 shadow-soft-elevation border border-gray-50 text-center">
    <div class="flex justify-center">
    <a href="/">
        <img src="images/logos/logo.png" alt="Misspitimini Logo" class="w-100 md:w-1/3 h-auto">
    </a>
    </div>
    <div x-data="{ activeSlide: 1, slides: [1, 2, 3, 4, 5] }">
        <Menu />
        <Carrusel />
    </div>
</header>