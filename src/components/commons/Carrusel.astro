---
---

<div class="relative w-full max-w-7xl mx-auto overflow-hidden shadow-xl">
    <div class="relative h-[350px] md:h-[500px]">
        <template x-for="slide in slides" :key="slide.id">
            <div x-show="activeSlide === slide.id" 
                 x-transition:enter="transition ease-out duration-500"
                 x-transition:enter-start="opacity-0 scale-105"
                 x-transition:enter-end="opacity-100 scale-100"
                 class="absolute inset-0">
                <img :src="slide.img" :alt="slide.title" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-black/10"></div>
            </div>
        </template>

        <button @click="activeSlide = activeSlide === 1 ? slides.length : activeSlide - 1" 
                class="absolute left-4 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button @click="activeSlide = activeSlide === slides.length ? 1 : activeSlide + 1" 
                class="absolute right-4 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
    </div>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex space-x-2 z-30">
        <template x-for="slide in slides" :key="slide.id">
            <button @click="activeSlide = slide.id" 
                    :class="activeSlide === slide.id ? 'bg-white w-8' : 'bg-white/50 w-2'" 
                    class="h-2 rounded-full transition-all duration-300"></button>
        </template>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-8 text-center h-24">
    <template x-for="slide in slides" :key="slide.id">
        <div x-show="activeSlide === slide.id"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0">
            <p class="text-xl md:text-3xl font-serif italic text-gray-800" x-text="slide.phrase"></p>
        </div>
    </template>
</div>