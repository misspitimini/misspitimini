        <slot />
    </h2>
    <div class="mt-5 flex items-center justify-center opacity-80" aria-hidden="true">
        <!--div class="h-px w-12 bg-primary mx-auto"></div> --> 
        <div class="w-12 h-px bg-primary/40"></div>
        <span class="mx-6 text-primary text-xl scale-125">
            &#10046;
        </span>
        <div class="w-12 h-px bg-primary/40"></div>
    </div>
</div>