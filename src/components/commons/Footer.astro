---
import SocialNetworks from '@components/commons/SocialNetworks.astro';
const currentYear = new Date().getFullYear();
---

<footer>
    <SocialNetworks />
    <hr/>
    <p class="text-lg leading-relaxed flex flex-wrap items-center justify-center gap-4">
        <span>&copy; {currentYear} • Todos los derechos reservados.</span>
        <a href="#" target="_self" rel="noopener noreferrer" class="inline-flex items-center">
            <img src="/images/logos/logo_10.jpg" alt="Logotipo" class="h-6 w-auto object-contain">
        </a>
    </p>
</footer>