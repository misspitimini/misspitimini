---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata | string;
    alt: string;
    loading?: 'eager' | 'lazy';
    fetchpriority?: 'high' | 'low' | 'auto';
    class?: string;
    quality?: 'low' | 'mid' | 'high' | 'max'; // Add quality prop
    [key: string]: any; // Allow other props
}

const { src, alt, loading, fetchpriority, class: className, quality, ...rest } = Astro.props;
---

<OptimizedImage 
    src={src} 
    alt={alt} 
    loading={loading}
    fetchpriority={fetchpriority}
    class:list={[className]}
    quality={quality}
    {...rest} 
/>
