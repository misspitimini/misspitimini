---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '@/components/commons/Icon.astro';
import { ICONS, type Platform } from '@/data/socials';

interface Props {
  platform: Platform;
  label: string;
  imgSrc: ImageMetadata;
  alt: string;
}

const { platform, label, imgSrc, alt } = Astro.props;

const iconData = ICONS[platform];

---

<a 
  href={iconData.href} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="relative group block w-full bg-zinc-900 overflow-hidden shadow-lg"
>
  <!-- Imagen de fondo -->
  <Image 
    src={imgSrc} 
    alt={alt} 
    class="absolute inset-0 object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
    widths={[200, 400]}
    sizes="(max-width: 768px) 50vw, 25vw"
    format="webp"
  />
  
  <!-- Degradado para legibilidad -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/20"></div>

  <!-- Contenido -->
  <div class="relative h-full flex flex-col items-center justify-center text-white p-4 transition-opacity duration-300 ease-in-out">
    <Icon {...iconData} class="w-10 h-10 mb-2 drop-shadow-lg" />
    <span class="font-semibold text-sm tracking-wider drop-shadow-lg">
      {label}
    </span>
  </div>
</a>
