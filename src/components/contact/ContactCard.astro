const current = config[platform];
const isExternal = !link.startsWith('tel:') && !link.startsWith('mailto:');
---

<div class="relative overflow-hidden shadow-sm group">
  <Image 
    alt={alt} 
    class="w-full h-32 object-cover group-hover:scale-105 transition-transform duration-1000" 
    src={imgSrc}
    widths={[200, 400, 600]}
    sizes="(max-width: 768px) 50vw, 25vw"
  />
  <div class="absolute inset-0 flex items-end justify-center pb-4 md:pb-8 bg-black/5">
    <a 
      href={link} 
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
      class="flex items-center justify-center bg-white text-black font-bold w-[90%] max-w-[220px] py-2.5 rounded-full transition-transform active:scale-95 shadow-lg px-4"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox={current.viewBox} fill="currentColor" class="mr-2 shrink-0">
        <path d={current.path} transform={current.transform}></path>
      </svg>
      <span class="text-[10px] sm:text-xs md:text-sm">
        {current.label}
      </span>
    </a>
  </div>
</div>