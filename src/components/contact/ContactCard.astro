---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '@/components/commons/Icon.astro';

// --- Tipado Fuerte ---
type Platform = 'email' | 'phone' | 'facebook' | 'tiktok' | 'instagram';

interface Props {
  platform: Platform;
  label: string;
  link: string;
  imgSrc: ImageMetadata;
  alt: string;
}

const { platform, label, link, imgSrc, alt } = Astro.props;

// --- Centralización de Iconos ---
const ICONS: Record<Platform, { path: string; viewBox?: string; transform?: string }> = {
  email: {
    path: 'M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0l-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z',
  },
  phone: {
