---
import BlogCard from '../components/BlogCard.astro';

const blogs:any[] = [];
---
<section>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4 rounded-xl shadow-sm">
    <div class="flex-1 text-center p-4">
      <h2 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-24 md:pb-0">
        Nuestro Blog
      </h2>
      <br />
      <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Las flores no solo decoran espacios; <b>marcan capítulos de nuestra vida</b>. En este rincón, compartimos la magia detrás de cada brote: desde la alegría de un regalo inesperado hasta el arte de cuidar tu primer jardín en casa. Porque cada flor tiene una historia, y queremos que nos ayudes a <b>contarla</b>.
      </p>
    </div>
  </div>
</section>

<section class="bg-white py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div id="blog-container" class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {blogs.map((blog) => (
        <BlogCard
          imgSrc={blog.imgSrc}
          imgAlt={blog.imgAlt}
          title={blog.title}
          description={blog.description}
          link={blog.link}
        />
      ))}
      </div>
    </div>
  </div>
</section>
<template id="card-blog-template" class="hidden">
    <BlogCard
      imgSrc=""
      imgAlt=""
      title=""
      description=""
      link=""
    />
</template>
