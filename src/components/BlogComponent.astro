---
import BlogCard from '../components/BlogCard.astro';

const blogs = [
  {
    imgSrc: "/images/body/blog/floresSecas.jpg",
    imgAlt: "Cómo cuidar tus flores secas",
    title: "Cómo cuidar tus flores secas",
    description: "Aprende a mantener tus flores secas en perfecto estado durante mucho tiempo.",
    link: "/workshops/centerpieces",
  },
  {
    imgSrc: "/images/body/blog/tendenciasBoda.jpg",
    imgAlt: "Flores para bodas: tendencias 2026",
    title: "Flores para bodas: tendencias 2026",
    description: "Descubre las últimas tendencias en arreglos florales para bodas y elige el estilo que más te guste.",
    link: "/workshops/centerpieces",
  },
  {
    imgSrc: "/images/body/blog/rosasSivestres.jpg",
    imgAlt: "DIY: crea tu propio ramo de flores",
    title: "DIY: crea tu propio ramo de flores",
    description: "Aprende a crear un ramo de flores espectacular con tus propias manos y sorprende a todos.",
    link: "/workshops/centerpieces",
  },
];
---
<section>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4 rounded-xl shadow-sm">
    <div class="flex-1 text-center p-4">
      <h2 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-24 md:pb-0">
        Nuestro Blog
      </h2>
      <br />
      <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Descubre consejos, trucos e inspiración para tus arreglos florales.
      </p>
    </div>
  </div>
</section>

<section class="bg-white py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {blogs.map((blog) => (
        <BlogCard
          imgSrc={blog.imgSrc}
          imgAlt={blog.imgAlt}
          title={blog.title}
          description={blog.description}
          link={blog.link}
        />
      ))}
      </div>
    </div>
  </div>
</section>
