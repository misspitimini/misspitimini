---
import BlogCard from '@components/BlogCard.astro';

const blogs:any[] = [];
---

<section class="space-y-10 px-6">
  <div class="text-center space-y-2">
    <h2 class="text-3xl font-serif">Nuestro Blog</h2>
    <div class="h-px w-12 bg-primary mx-auto"></div>
  </div>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
    <div class="flex-1 text-center">
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Las flores no solo decoran espacios; <b>marcan capítulos de nuestra vida</b>. En este rincón, compartimos la magia detrás de cada brote: desde la alegría de un regalo inesperado hasta el arte de cuidar tu primer jardín en casa. Porque cada flor tiene una historia, y queremos que nos ayudes a <b>contarla</b>.
      </p>
    </div>
  </div>
</section>
  <div id="blog-container" class="columns-2 gap-4 space-y-4">
    {blogs.map((blog) => (
      <BlogCard
        imgSrc={blog.imgSrc}
        imgAlt={blog.imgAlt}
        title={blog.title}
        description={blog.description}
        link={blog.link}
      />
    ))}
  </div>

<template id="card-blog-template" class="hidden">
    <BlogCard
      imgSrc=""
      imgAlt=""
      title=""
      description=""
      link=""
    />
</template>
