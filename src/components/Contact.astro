---

<section id="contact" class="py-20 bg-[#FBF7F2]">
    <div class="container mx-auto px-4">
        <h2 class="text-4xl font-bold font-serif text-center mb-12 text-[#2c3e50]">Get in Touch</h2>
        <form class="max-w-xl mx-auto">
            <div class="mb-6">
                <label for="name" class="block text-[#2c3e50] mb-2">Name</label>
                <input type="text" id="name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-[#E8A2A2]">
            </div>
            <div class="mb-6">
                <label for="email" class="block text-[#2c3e50] mb-2">Email</label>
                <input type="email" id="email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-[#E8A2A2]">
            </div>
            <div class="mb-6">
                <label for="message" class="block text-[#2c3e50] mb-2">Message</label>
                <textarea id="message" rows="5" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-[#E8A2A2]"></textarea>
            </div>
            <div class="text-center">
                <button type="submit" class="bg-[#E8A2A2] text-white font-bold py-3 px-8 rounded-full hover:bg-[#d48c8c] transition-colors duration-300">Send Message</button>
            </div>
        </form>
    </div>
</section>