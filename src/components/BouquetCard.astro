---
interface Props {
  imgSrc: string;
  imgAlt: string;
  title: string;
  description: string;
}

const { imgSrc, imgAlt, title, description } = Astro.props;
---

<div class="shadow-soft-elevation">
  <img class="w-full h-56 object-cover" src={imgSrc} alt={imgAlt}>
  <div class="p-6">
    <h3 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide">{title}</h3>
    <p class="mt-2 text-base text-gray-500">
      {description}
    </p>
    <div class="mt-4">
      <a href="#" class="text-base font-medium text-pink-500 hover:text-pink-600">
        Leer más &rarr;
      </a>
    </div>
  </div>

