---
import { Image } from 'astro:assets';
import logo from '@assets/images/logos/logoReducido.png';
import MenuItems from '@components/header/MenuItems.astro';
---
<div class="relative flex items-center h-20 max-w-7xl mx-auto px-6">

    <!-- Left: Logo (desktop) / Hamburger (mobile) -->
    <div class="flex-1 flex justify-start">
        <a href="/" class="hidden md:block">
            <Image src={logo} alt="Logotipo" class="w-48 h-auto" />
        </a>
        <button
            class="flex md:hidden z-40 items-center justify-center p-2 -ml-2 rounded-full active:scale-95 transition-transform"
            @click="open = !open"
        >
            <svg x-show="!open" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            <svg x-show="open" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <!-- Center: Logo (mobile) -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 md:hidden">
         <a href="/" class="block">
            <Image src={logo} alt="Logotipo" class="w-40 h-auto" />
        </a>
    </div>

    <!-- Right: Nav (desktop) / Spacer (mobile) -->
    <div class="flex-1 flex justify-end">
        <nav class="hidden md:flex items-center space-x-8">
            <MenuItems />
        </nav>
        <!-- Spacer for mobile to balance hamburger icon -->
        <div class="w-8 h-8 md:hidden"></div>
    </div>
</div>
