---
import { menuItems } from '@data/menuData.js';
---

<template x-for="item in menuItems" :key="item.id">
    <a :href="item.url"
       class="relative font-display text-lg md:text-base transition-all duration-300 hover:font-bold"
    >
        <span x-text="item.title"></span>
    </a>
</template>
