---
import { slides } from '@/data/menuData.js';
import { Icon } from 'astro-icon/components';

interface Props {
    href: string;
}
const {href} = Astro.props;

// Find the current index in the array (0 to 6)
const currentIndex = slides.findIndex(s => s.url === href);

// Circular logic:
// If it's the first, the previous is the last. If it's the last, the next is the first.
const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
const nextIndex = (currentIndex + 1) % slides.length;

const prevUrl = slides[prevIndex].url;
const nextUrl = slides[nextIndex].url;

---
  <div 
    class="flex items-center justify-between w-full md:hidden"
    data-prev-url={prevUrl}
    data-next-url={nextUrl}
    id="carrusel-nav"
  >
    <a 
      href={prevUrl} 
      aria-label="Anterior" 
      class="material-symbols-outlined text-primary p-2 hover:bg-black/5 rounded-full transition-colors"
    >
      <Icon name="material-symbols:arrow-back" class="w-6 h-6" />
    </a>
  
    <a 
      href={nextUrl} 
      aria-label="Siguiente" 
      class="material-symbols-outlined text-primary p-2 hover:bg-black/5 rounded-full transition-colors"
    >
      <Icon name="material-symbols:arrow-forward" class="w-6 h-6" />
    </a>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const nav = document.getElementById('carrusel-nav');
      if (!nav) return;

      const prevUrl = nav.dataset.prevUrl;
      const nextUrl = nav.dataset.nextUrl;

      let touchstartX = 0;
      let touchendX = 0;
        
      const threshold = 70; // Minimum distance for a swipe
    
      function handleGesture() {
        if (touchendX < touchstartX - threshold) {
          // Swiped left -> Go to Next
          if (nextUrl) window.location.href = nextUrl;
        }
        if (touchendX > touchstartX + threshold) {
          // Swiped right -> Go to Previous
          if (prevUrl) window.location.href = prevUrl;
        }
      }
    
      const mainElement = document.querySelector('main');
      if (!mainElement) return;

      mainElement.addEventListener('touchstart', e => {
        touchstartX = e.changedTouches[0].screenX;
      }, { passive: true });
    
      mainElement.addEventListener('touchend', e => {
        touchendX = e.changedTouches[0].screenX;
        handleGesture();
      }, { passive: true });
    });
  </script>
