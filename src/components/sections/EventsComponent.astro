---
import OptimizedImage from '@components/commons/OptimizedImage.astro';
import CustomLink from '@components/commons/CustomLink.astro';
import content from '@/content/events.json';
import img from '@assets/images/body/eventos/evento.jpg';
---

<div class="space-y-12">

  <!-- Events Section -->
  <section class="space-y-6">
    <div class="px-6">
      <div class="text-center space-y-2">
        <h2 class="text-3xl font-serif">{content.title}</h2>
        <div class="h-px w-12 bg-primary mx-auto mt-2"></div>
      </div>
      <br/>
      <div class="max-w-4xl mx-auto text-justify text-floral-dark/80 leading-relaxed space-y-4">
        <p set:html={content.intro} />
        
        <ul class="list-disc space-y-4 pl-5">
          {content.eventTypes.map(event => (
            <li><strong>{event.title}:</strong> {event.description}</li>
          ))}
        </ul>

        <p>
          {content.cta.text}
          <CustomLink href={content.cta.href} set:html={content.cta.linkText} />.
        </p>
      </div>
    </div>
    
    <div class="w-full pt-4">
      <OptimizedImage 
        alt={content.image.alt} 
        class="w-full h-full object-cover" 
        src={img}
        widths={[400, 800, 1200, 1600]}
        sizes="100vw"
      />
    </div>
  </section>

</div>
