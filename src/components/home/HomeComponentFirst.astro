---
import { processHomeCards } from '@/utils/card-processing';
import HomeCard from '@/components/home/HomeCard.astro';
import SectionTitle from '../commons/SectionTitle.astro';
import ContentSection from '../layout/ContentSection.astro';

const homeCards = await processHomeCards(['2-bodas', '3-eventos']);

---

<ContentSection>
  <SectionTitle>Experiencias Florales y Gastronómicas</SectionTitle>
  <p class="text-lg text-floral-dark/80 mt-2 hidden text-center">Talleres de arte floral en Madrid y decoración de eventos con flores naturales</p>
</ContentSection>
<div class="grid grid-cols-2 gap-1 md:gap-6">
  {homeCards.map(card => (
    <HomeCard 
      card={card}  
      widths={[412]}
      sizes="(max-width: 768px) 50vw, 412px"
    />
  ))}
</div>
