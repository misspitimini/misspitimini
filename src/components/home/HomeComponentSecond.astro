---
import CustomLink from '@components/commons/CustomLink.astro';
---

    <section class="px-10 text-center">
    <div class="w-32 h-32 md:w-64 md:h-64 mx-auto rounded-full overflow-hidden border-4 border-floral-beige shadow-lg">
      <img alt="Sara Laínez" class="w-full h-full object-cover" src="/images/carrusel/01_misspitimini.jpg"/>
    </div>
    <div class="space-y-4">
      <h2 class="text-2xl font-serif mt-6"> Floral Designer</h2>
      <p class="text-floral-dark/80 text-sm leading-relaxed italic max-w-md mx-auto text-justify">
        <strong>Sara Laínez</strong> es una diseñadora floral apasionada por crear experiencias únicas e
        inolvidables a través del <strong>arte de la floristería</strong>. Con un ojo atento al detalle y una
        dedicación a la calidad, transforma flores en <strong>arreglos florales</strong> impactantes que cuentan
        una historia.
      </p>
      <p class="text-floral-dark/80 text-sm leading-relaxed italic max-w-md mx-auto text-justify">
        Su obra se inspira en la belleza natural del mundo que nos rodea y cree que las flores tienen el
        poder de <strong>evocar emociones</strong> y <strong>crear impresiones duraderas</strong>. Ya sea una <strong><CustomLink href="/bodas/">boda</CustomLink></strong>,
        un <strong><CustomLink href="/eventos/">evento especial</CustomLink></strong> o un simple <strong><CustomLink href="/experiencias/">gesto de amor</CustomLink></strong>, Sara pone todo su corazón en cada
        creación.
      </p>
      <p class="text-[10px] font-bold tracking-widest uppercase text-primary">Sara Laínez</p>
      </div>
    </section>
    <section class="space-y-10">
      <div class="columns-2 space-y-4 gap-1 md:gap-4">
        <div>
        <div class=" overflow-hidden shadow-sm group">
          <a href="/blog/" rel="noopener noreferrer">
              <img alt="Sara Lainez sonriente sentada en la base de una farola monumental de la plaza Mayor de Madrid. Viste un vestido blanco largo de estilo veraniego, sandalias rojas y un sombrero de paja decorado con flores." class="w-full h-[300px] object-cover group-hover:scale-105 transition-transform duration-1000" src="/images/carrusel/07_blog.jpg"/>
          </a>
        </div>
          <h3 class="text-xl md:text-3xl font-serif italic text-gray-800">
            <a href="/blog/" rel="noopener noreferrer">Blog</a>
          </h3>
          <p class="text-[16px] text-floral-dark/60">Compartir experiencias con las flores</p>
         </div>
         <div>
        <div class=" overflow-hidden shadow-sm group">
          <a href="/galeria/" rel="noopener noreferrer">
            <img alt="Un hermoso y abundante ramo de flores que destaca por su variedad y colorido" class="w-full h-[300px] object-cover group-hover:scale-105 transition-transform duration-1000" src="/images/carrusel/05_ramosFlores.jpg"/>
          </a>
        </div>
          <h3 class="text-xl md:text-3xl font-serif italic text-gray-800">
            <a href="/galeria/" rel="noopener noreferrer">Galería</a>
          </h3>
          <p class="text-[16px] text-floral-dark/60">Cada flor, una memoria que florece</p>
        </div>
      </div>
    </section>