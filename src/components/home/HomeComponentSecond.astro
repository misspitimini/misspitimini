---
import { getHomeCards } from '../../utils/homeCards';
import HomeCard from './HomeCard.astro';

const homeCards = await getHomeCards(['4-blog', '5-galeria']);

---

<section class="space-y-12">
  <div class="grid grid-cols-2 gap-1 md:gap-6">
    {homeCards.map(card => (
      <HomeCard card={card} />
    ))}
  </div>
</section>
