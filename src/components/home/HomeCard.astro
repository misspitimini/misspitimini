---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';

// Renombramos `quality` de Astro.props a `propQuality` para evitar el conflicto.
const { card, quality = 60 } = Astro.props;

// Ahora podemos desestructurar `quality` del objeto `card` sin problemas.
const { imgSrc, imgAlt, title, description, link, buttonText, isLargeCard } = card;

---

<div class:list={["space-y-4", { "col-span-2 mt-6": (isLargeCard && buttonText) }, { "col-span-2 md:col-span-1 mt-6": (isLargeCard && !buttonText) } ]}>
  <div class="overflow-hidden shadow-sm group relative">
      {link=='/galeria/'  && (
           <OptimizedImage 
              alt={imgAlt} 
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-1000" 
              src={imgSrc} 
              widths={[400, 800, 1200, 1600, 2400, 3200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 50vw"
              quality={quality}
            />
          )}
      {imgSrc && link!='/galeria/'  && (
          <div class="inset-0 w-full">
            <OptimizedImage 
              alt={imgAlt} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" 
              src={imgSrc} 
              widths={[400, 800, 1200, 1600, 2400, 3200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 50vw"
              quality={quality}
            />
            <div class="absolute inset-0 bg-gradient-to-r from-white via-transparent to-white opacity-60"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-white via-transparent to-transparent opacity-60"></div>
          </div>
      )}
      
      {buttonText && (
          <a href={link} rel="noopener noreferrer hover:cursor-pointer">
          <div class="absolute inset-0 flex items-end justify-center pb-[10px] md:pb-[54px]">
            <span class="inline-block bg-white/95 backdrop-blur-sm text-floral-dark px-10 py-4 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full shadow-xl active:scale-95 transition-all">
              {buttonText}
            </span>
            </div>
            </a>
          )}
  </div>
  <div class:list={["space-y-4", { "col-span-2": isLargeCard }]}>
    <a href={link} rel="noopener noreferrer hover:cursor-pointer">
      <h3 class="text-3xl md:text-3xl font-serif italic text-gray-800">{title}</h3>
      <p class="text-[16px] text-floral-dark/60">
        {description}
      </p>
    </a>
  </div>
</div>
