---
import BouquetCard from '../components/GalleryCard.astro';

const bouquets = [
  {
    imgSrc: "/images/body/ramos/ramo01.jpg",
    imgAlt: "Ramo de flores silvestres",
    title: "Ramo Silvestre",
    description: " Un ramo de flores silvestres, perfecto para un look bohemio y natural.",

  },
  {
    imgSrc: "/images/body/ramos/ramo02.jpg",
    imgAlt: "Ramo de flores secas",
    title: "Ramo de Flores Secas",
    description: "Un ramo de flores secas que perdurará en el tiempo, ideal para decorar tu hogar.",

  },
  {
    imgSrc: "/images/body/ramos/ramo03.jpg",
    imgAlt: "Ramo de novia",
    title: "Ramo de Novia",
    description: "El ramo de novia de tus sueños, diseñado a medida para tu día más especial.",

  },
  {
    imgSrc: "/images/body/ramos/ramo04.jpg",
    imgAlt: "Centro de mesa",
    title: "Centro de Mesa",
    description: "Un centro de mesa elegante y sofisticado para tus cenas y eventos más especiales.",
  },
  {
    imgSrc: "/images/body/ramos/ramo05.jpg",
    imgAlt: "Ramo personalizado",
    title: "Ramo Personalizado",
    description: "Crea tu ramo a medida, elige tus flores favoritas y nosotros nos encargamos del resto.",
  },
  {
    imgSrc: "/images/body/ramos/floresSecas.jpg",
    imgAlt: "Ramo de temporada",
    title: "Ramo de Temporada",
    description: "Un ramo con las flores más frescas y bonitas de cada temporada.",
  },
];

---

<section>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4 rounded-xl shadow-sm">
    <div class="flex-1 text-center p-4">
      <h2 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-24 md:pb-0">
        Nuestros Ramos Personalizados
      </h2>

      <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Descubre nuestra colección de ramos de flores, diseñados con pasión y cuidado para cada ocasión.
      </p>
    </div>
  </div>
</section>

<section class="bg-white py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {bouquets.map((bouquet) => (
        <BouquetCard
          imgSrc={bouquet.imgSrc}
          imgAlt={bouquet.imgAlt}
          title={bouquet.title}
          description={bouquet.description}
        />
      ))}
    </div>
  </div>
</section>

