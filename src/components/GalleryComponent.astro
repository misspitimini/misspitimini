---
import GalleryCard from '@components/GalleryCard.astro';

const galleries:any[] = [];
---
<section class="space-y-10">
  <div class="text-center space-y-2">
    <h2 class="text-3xl font-serif">Nuestros Recuerdos</h2>
    <div class="h-px w-12 bg-primary mx-auto"></div>
  </div>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
    <div class="flex-1 text-center">
      <p class="indent-2 text-floral-dark/80 text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Hay palabras que solo las flores saben decir. <b>Nuestra galería</b> es un recorrido por las emociones que hemos ayudado a cultivar. Desde <b>bodas</b> en en tonos pastel, hasta la energía vibrante de un <b>taller</b> en colores cítricos. Cada pétalo aquí presente cuenta una historia; <b>te invitamos a encontrar la tuya</b>.
      </p>
    </div>
  </div>
</section>

<section class="bg-white py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div id="gallery-container" class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {galleries.map((gallery) => (
        <GalleryCard
          imgSrc={gallery.imgSrc}
          imgAlt={gallery.imgAlt}
          title={gallery.title}
          description={gallery.description}
          link={gallery.link}
        />
      ))}
    </div>
  </div>
</section>
<template id="card-gallery-template" class="hidden">
  <GalleryCard
    imgSrc=""
    imgAlt=""
    title=""
    description=""
    link=""
  />
</template>

