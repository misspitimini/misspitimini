---
interface Props {
  imgSrc: string;
  imgAlt: string;
  title: string;
  description: string;
  link: string;
}

const { imgSrc, imgAlt, title, description, link } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md overflow-hidden transform hover:scale-105 transition-transform duration-300 ease-in-out">
  <img class="w-full h-80 object-cover" src={imgSrc} alt={imgAlt} />
  <div class="p-6 text-center">
    <h3 class="font-display text-2xl font-semibold text-gray-800 mb-2">{title}</h3>
    <p class="text-base text-gray-600">{description}</p>
    <div class="mt-4">
      <a href={link} class="text-base font-medium text-pink-500 hover:text-pink-600">
        Leer más &rarr;
      </a>
    </div>
  </div>
</div>
