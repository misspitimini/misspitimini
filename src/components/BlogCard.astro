---
interface Props {
  imgSrc: string;
  imgAlt: string;
  title: string;
  description: string;
  link: string;
}

const { imgSrc, imgAlt, title, description, link } = Astro.props;
---
<div class="overflow-hidden w-fit">
  <img class="card-img h-auto w-full object-cover" src={imgSrc} alt={imgAlt} />
  
  <div class="px-2"> <h3 class="card-title text-xl md:text-3xl font-serif italic text-gray-800">{title}</h3>
    <p class="card-description text-[16px] text-floral-dark/60">
      {description}
    </p>
    <div class="mt-4">
      <a href={link} class="card-link text-base font-medium text-pink-500 hover:text-pink-600">
        Leer más &rarr;
      </a>
    </div>
  </div>
</div>
