---
interface Props {
  imgSrc: string;
  imgAlt: string;
  title: string;
  description: string;
  link: string;
}

const { imgSrc, imgAlt, title, description, link } = Astro.props;
---

<div class="shadow-soft-elevation">
  <img class="card-img w-full h-56 object-cover" src={imgSrc} alt={imgAlt} />
  <div class="p-6">
    <h3 class="card-title font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide">{title}</h3>
    <p class="card-description mt-2 text-base text-gray-500">{description}</p>
    <div class="mt-4">
      <a href={link} class="card-link text-base font-medium text-pink-500 hover:text-pink-600">
        Leer más &rarr;
      </a>
    </div>
  </div>
</div>
