---
import PrivacyPolicy from '@components/commons/PrivacyPolicy.astro';
---
<section>
    <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
      <div class="flex-1 text-center">
        <h2 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-24 md:pb-0">
          Ponte en contacto con Sara Laínez
      </h2>
      <br />
      <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
        Cada proyecto comienza con una <b>conversación</b>. Si buscas <b>una mirada experta</b>  que transforme tu idea en una atmósfera viva, estás en el lugar adecuado. <b>Sara Laínez</b>  te ofrece un <b>asesoramiento</b> personalizado para dar con la narrativa floral que tu evento o espacio necesita. Cuéntanos qué tienes en mente y permítenos <b>guiarte</b> en el proceso de dar vida a tu visión.
      </p>
      <br />
  </div>
</div>
</section>
<section>
<div class="flex flex-col lg:flex-row items-center gap-7 px-8">
<form id="formularioContacto" class="w-full" novalidate>
  <div class="flex-1 text-center">
  <h3 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-0 sm:pb-12 md:pb-12">
   Enviando un mensaje:
  </h3>
  <div 
  id="message-success" 
  class="hidden flex items-center gap-2 p-2.5 mt-2 text-green-700 bg-green-50 border border-green-200 rounded-md transition-all duration-200 ease-in-out"
  role="alert" >
  <div class="flex-shrink-0 text-green-500">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
    </svg>
  </div>
  <span class="text-sm font-medium"></span>
  </div>
  <div class="flex-1 text-center">
  <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
    <label for="nombre" class="block text-[#2c3e50] mb-2">Nombre (*):</label>
    <input type="text" id="nombre" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black">
    <div 
      id="error-nombre" 
      class="hidden flex items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
      role="alert" >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
    </div>
  </p>
  <br />
  <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
    <label for="telefono" class="block text-[#2c3e50] mb-2">Teléfono (*):</label>
    <input type="tel" id="telefono" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black">
    <div 
    id="error-telefono" 
    class="hidden flex items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
    role="alert" >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
  </div>
  </p>
  <br />
  <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
      <label for="email" class="block text-[#2c3e50] mb-2">Email (*):</label>
      <input type="email" id="email" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black">
      <div 
      id="error-email" 
      class="hidden flex items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
      role="alert" >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
    </div>
  </p>
  <br />
  <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
      <label for="mensaje" class="block text-[#2c3e50] mb-2">Comentario (*):</label>
      <textarea id="mensaje" rows="5" class="w-full px-4 py-2 border border-gray-300 focus:outline-none focus:border-black"></textarea>
      <div 
      id="error-mensaje" 
      class="hidden flex items-center gap-1.5 text-red-600 transition-all duration-200 ease-in-out"
      role="alert" >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-xs font-medium italic">Este campo es obligatorio.</span>
    </div>
  </p>
  </div>
  <PrivacyPolicy>
    <div class="text-center">
      <button type="submit" class="bg-black text-white font-bold py-3 px-8 rounded-full">Enviar</button>
    </div>
  </PrivacyPolicy>
</form>  
</div>
</section>
<section>
  <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
    <div class="flex-1 text-center">
      <h3 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide sm:pb-12 md:pb-12">
        También puedes contactar medianta una llamada telefónica o un correo electrónico:
      </h3>
      <div class="md:flex">
        <div class="my-8 md:flex-1 md:text-center  md:text-end md:mx-8">
          <a href="tel:+34684340789" 
          class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95">
          (+34) 684 34 07 89
          </a>
        </div>
        <div class="my-8 md:flex-1 text-center md:text-start md:mx-8">
          <a href="mailto:hola@misspitimini.com" 
          class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95">
          hola@misspitimini.com
          </a>
        </div>
      </div>
    </div>
  </div>
  </section>
  <br />
  <section>
    <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
      <div class="flex-1 text-center">
        <h3 class="font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide sm:pb-12 md:pb-12">
          Síguenos en nuestras redes sociales:
        </h3>
        <br />
        <p class="indent-2 font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide">
          El universo de <b>Sara Laínez</b> es una ventana abierta a la naturaleza y la creatividad. Te invitamos a seguir nuestro día a día, donde compartimos procesos creativos, la llegada de nuevas temporadas y el detrás de escena de nuestros montajes más especiales. <b>Únete a nuestra comunidad</b> y deja que la inspiración floral forme parte de tu rutina.
        </p>
        <br />
        <div class="md:flex">
          <div class="my-8 md:flex-1 md:text-center md:mx-8">
            <a href="https://www.facebook.com/misspitimini/?locale=es_ES" 
               class="inline-flex items-center justify-center gap-x-3 bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95 w-full max-w-xs">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 9.34 18" fill="currentColor" class="shrink-0">
                <path d="M28.76,24.46V16.27h2.76l.41-3.21H28.76V11c0-.92.25-1.56,1.58-1.56H32V6.59a22.71,22.71,0,0,0-2.47-.13,3.87,3.87,0,0,0-4.12,4.24v2.35H22.69v3.21h2.75v8.2Z" transform="translate(-22.69 -6.46)"></path>
              </svg>
              <span>Facebook</span>
            </a>
          </div>
          <div class="my-8 md:flex-1 md:text-center md:mx-8">
            <a href="https://www.tiktok.com/@misspitimini_official?hl=es" 
               class="inline-flex items-center justify-center gap-x-3 bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95 w-full max-w-xs">
               <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
               fill="currentColor" class="transform translate-x-[0.7px]">
               <path transform="scale(0.7)" d="M16.656 1.029c1.637-0.025 3.262-0.012 4.886-0.025 0.054 2.031 0.878 3.859 2.189 5.213l-0.002-0.002c1.411 1.271 3.247 2.095 5.271 2.235l0.028 0.002v5.036c-1.912-0.048-3.71-0.489-5.331-1.247l0.082 0.034c-0.784-0.377-1.447-0.764-2.077-1.196l0.052 0.034c-0.012 3.649 0.012 7.298-0.025 10.934-0.103 1.853-0.719 3.543-1.707 4.954l0.020-0.031c-1.652 2.366-4.328 3.919-7.371 4.011l-0.014 0c-0.123 0.006-0.268 0.009-0.414 0.009-1.73 0-3.347-0.482-4.725-1.319l0.040 0.023c-2.508-1.509-4.238-4.091-4.558-7.094l-0.004-0.041c-0.025-0.625-0.037-1.25-0.012-1.862 0.49-4.779 4.494-8.476 9.361-8.476 0.547 0 1.083 0.047 1.604 0.136l-0.056-0.008c0.025 1.849-0.050 3.699-0.050 5.548-0.423-0.153-0.911-0.242-1.42-0.242-1.868 0-3.457 1.194-4.045 2.861l-0.009 0.030c-0.133 0.427-0.21 0.918-0.21 1.426 0 0.206 0.013 0.41 0.037 0.61l-0.002-0.024c0.332 2.046 2.086 3.59 4.201 3.59 0.061 0 0.121-0.001 0.181-0.004l-0.009 0c1.463-0.044 2.733-0.831 3.451-1.994l0.010-0.018c0.267-0.372 0.45-0.822 0.511-1.311l0.001-0.014c0.125-2.237 0.075-4.461 0.087-6.698 0.012-5.036-0.012-10.060 0.025-15.083z"></path>
               </svg>
              <span>Tiktok</span>
            </a>
          </div>
          <div class="my-8 md:flex-1 md:text-center md:mx-8">
            <a href="https://www.instagram.com/misspitimini_official/?hl=es" 
               class="inline-flex items-center justify-center gap-x-3 bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95 w-full max-w-xs">
               <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
               fill="currentColor" class="transform translate-x-[0.7px]">
               <path
                   d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.058-1.69-.072-4.949-.072zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
               </svg>
              <span>Instagram</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>


