---
import Layout from '@layouts/Layout.astro';
import ArrowsCarrusel from '@components/commons/ArrowsCarrusel.astro';
import HomeComponentFirst from '@components/home/HomeComponentFirst.astro';
import HomeComponentHero from '@components/home/HomeComponentHero.astro';
import HomeComponentSecond from '@components/home/HomeComponentSecond.astro';

import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
---

<Layout title="misspitimini | Floral Design by Sara Laínez">
	<Header activeSlide={1} href="/" />
	<main class="relative pt-20 pb-12">
		<ArrowsCarrusel href="/" />
		
		<div class="px-0 py-10 space-y-12">
			<HomeComponentFirst  />
			<HomeComponentHero  />
			<HomeComponentSecond  />
		</div>
	</main>
	<Footer />
</Layout>