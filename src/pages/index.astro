---
import Layout from '@/layouts/Layout.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import HomeComponentFirst from '@/components/home/HomeComponentFirst.astro';
import HomeComponentHero from '@/components/home/HomeComponentHero.astro';
import HomeComponentSecond from '@/components/home/HomeComponentSecond.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';

import Header from '@/components/header/Header.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/";

const title = "Diseño Floral para Bodas y Eventos en Madrid | Sara Laínez | misspitimini" 
const h1 = "Diseño floral para bodas, eventos corporativos y talleres creativos en Madrid"
const description = "Diseño floral personalizado para bodas, eventos corporativos y experiencias florales en Madrid. Sara Laínez crea propuestas únicas llenas de sensibilidad, creatividad y belleza natural."
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const keywords = "diseño floral, bodas, eventos, talleres florales, experiencias, Madrid, florista, ramos de novia, decoración floral"
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} keywords={keywords}>
	<Header href={href} h1={h1} />
	<div class="sr-only">
		<p class="text-lg text-floral-dark/80 mt-2">Creaciones únicas y personalizadas para momentos inolvidables</p>
	</div>
	<main class="relative pt-20 pb-12">
		<Carrusel href={href} />
		<SectionContainer>
			<HomeComponentFirst />
			<HomeComponentHero />
			<HomeComponentSecond />
		</SectionContainer>
	</main>
	<Footer />
</Layout>
