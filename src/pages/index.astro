
---
import Layout from '@/layouts/Layout.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import HomeComponentFirst from '@/components/home/HomeComponentFirst.astro';
import HomeComponentHero from '@/components/home/HomeComponentHero.astro';
import HomeComponentSecond from '@/components/home/HomeComponentSecond.astro';

import Header from '@/components/header/Header.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/";
---

<Layout 
    title="Sara Laínez | Diseño Floral para Bodas y Eventos en Madrid" 
    description="Descubre el reino de las flores de Sara Laínez, tu diseñadora floral en Madrid especializada en bodas, eventos y talleres únicos. Embellecemos tus momentos más especiales."
    image="/saraLaínez.jpg"
	keywords="florista, bodas, eventos, talleres florales, Madrid, diseño floral, ramos de novia, decoración floral"
>
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<div class="sr-only">
			<h1 class="text-4xl font-serif font-bold text-floral-dark">Diseño Floral para bodas, eventos y experiencias en Madrid</h1>
			<p class="text-lg text-floral-dark/80 mt-2">Creaciones únicas y personalizadas para momentos inolvidables</p>
		</div>
		<Carrusel href={href} />
		<div class="px-0 py-10 space-y-12">
			<HomeComponentFirst />
			<HomeComponentHero />
			<HomeComponentSecond />
		</div>
	</main>
	<Footer />
</Layout>
