---
import Layout from '@layouts/Layout.astro';
import HeroIndex from '@components/commons/HeroIndex.astro';
import HeroIndex2 from '@components/commons/HeroIndex2.astro';
import HeroIndex3 from '@components/commons/HeroIndex3.astro';

import Header from '@components/commons/Header.astro';
import Footer from '@components/commons/Footer.astro';
---

<Layout title="misspitimini | Floral Design by Sara Laínez">
	<Header activeSlide={1} href="/" />
	<main class="relative pt-20 pb-12">
		<HeroIndex activeSlide={1} href="/" />
		
		<div class="px-0 py-10 space-y-12">
			<HeroIndex2  />
			<HeroIndex3  />
		</div>
	</main>
	<Footer />
</Layout>