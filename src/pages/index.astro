---
import Layout from '@/layouts/Layout.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import HomeComponentFirst from '@/components/home/HomeComponentFirst.astro';
import HomeComponentHero from '@/components/home/HomeComponentHero.astro';
import HomeComponentSecond from '@/components/home/HomeComponentSecond.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';

import Header from '@/components/header/Header.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/";

const title = "Diseño Floral para bodas, eventos en Madrid | mispitimini | Experiencias y Talleres por Sara Laínez" 
const description = "Diseño floral para bodas, eventos y talleres en Madrid. Creaciones únicas por Sara Laínez. Ramos, decoración y experiencias florales personalizadas."
const keywords = "florista, bodas, eventos, talleres florales, experiencias, Madrid, diseño floral, ramos de novia, decoración floral"
---

<Layout title={title} description={description} keywords={keywords}>
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<div class="sr-only">
			<h1 class="text-4xl font-serif font-bold text-floral-dark">Arreglos florales para bodas, eventos corporativos y actividades como talleres de composición en Madrid por Sara Laínez, mispitimini</h1>
			<p class="text-lg text-floral-dark/80 mt-2">Creaciones únicas y personalizadas para momentos inolvidables</p>
		</div>
		<Carrusel href={href} />
		<SectionContainer>
			<HomeComponentFirst />
			<HomeComponentHero />
			<HomeComponentSecond />
		</SectionContainer>
	</main>
	<Footer />
</Layout>
