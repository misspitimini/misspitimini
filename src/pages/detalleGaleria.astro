---
import LayoutGalleryDetail from '@layouts/LayoutGalleryDetail.astro';
import Footer from '@components/footer/Footer.astro';
---

<LayoutGalleryDetail title="misspitimini | Blog de Sara Laínez">
	<header id="post-content-header">
		<div class="relative w-full max-w-7xl mx-auto px-4 py-4 flex items-center justify-center">
			<a href="/" class="z-50">
				<img src="/images/logos/logoReducido.png" alt="Logotipo" class="w-32 md:w-48 h-auto">
			</a>
		
			<div class="absolute right-4">
				<a href="/galeria/" class="text-gray-600 hover:text-black transition-colors">
					<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</a>
			</div>
		</div>
	</header>
	<main id="post-content-main" x-data="{ 
        activeSlideGallery: 0,
        galleryLength: 2,
		touchstartX: 0,
		touchendX: 0,
		threshold: 50,
		next() {
       	 	this.activeSlideGallery = (this.activeSlideGallery + 1) % this.galleryLength;
			window.updateCarousel(this.activeSlideGallery);
		},
    	prev() {
        	this.activeSlideGallery = (this.activeSlideGallery - 1 + this.galleryLength) % this.galleryLength;
			window.updateCarousel(this.activeSlideGallery);
		},
		load(index) {
        	this.activeSlideGallery = index;
			window.updateCarousel(this.activeSlideGallery);
		},
		changeClass(index) {
			 if(this.activeSlideGallery === index) {
				return 'border-black scale-105';
			}
			else
			{
				return 'border-transparent opacity-60 hover:opacity-100';
			} 
		},
		handleGesture()  {
			// Calculamos la distancia del deslizamiento
			const deltaX = this.touchendX - this.touchstartX;

			// Si el deslizamiento supera el umbral (threshold)
			if (Math.abs(deltaX) > this.threshold) {
				if (deltaX < 0) {
					// Deslizó a la izquierda -> Siguiente
					this.next();
				} else {
					// Deslizó a la derecha -> Anterior
					this.prev();
				}

				// Sincronización con el DOM (Evita el error de querySelector nulo)
				this.$nextTick(() => {
					const currentImg = document.querySelectorAll('.card-img')[this.activeSlideGallery];
					if (currentImg) {
						// Aquí ya puedes manipular la imagen sin que sea null
						console.log('Imagen activa actual:', currentImg.src);
					}
				});
			}
		},
		images: ['']
    }"
	@touchstart="touchstartX = $event.touches[0].screenX;"
    @touchend="touchendX = $event.changedTouches[0].screenX; handleGesture()"
	>
	<hr style="margin-bottom:2px; padding-bottom:2px"/>
		<div id="card-content-images" x-ref="slider" class="relative w-full max-w-[800px] mx-auto overflow-hidden">
		<button 
            @click="prev()"
        	class="absolute left-4 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-white cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
        </button>
        <button
		 	@click="next()"
        	class="absolute right-4 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-white cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </button>
		</div>
		<div class="flex flex-col items-center gap-7">
			<p class="card-title">
				Donde las flores se convierten en recuerdos
			</p>
		 </div>
		<div class="card-content-thumb flex justify-center gap-2 mt-4" x-ref="galleryContainer">
			<template x-for="(img, index) in images" :key="`thumb-template_${index}`">
				<button 
					type="button"
					@click="load(index)"
					class="relative w-20 h-20 overflow-hidden rounded-md border-2 transition-all"
					:class="changeClass(index)">
					
					<img :src="img" class="card-img w-full h-full object-cover hidden" loading="lazy">
				</button>
			</template>
		</div>
		<section>
			<div class="flex flex-col lg:flex-row items-center gap-7 p-2 md:p-4">
			  <div class="flex-1">
				<div class="card-content" >Cargando contenido...</div>
			  </div>
			</div>
		</section>
		<hr/>
		<div class="text-center">
			<a href="/galeria/" 
			class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95 px-12">
			Volver
			</a>
		</div>
	</main>
	<Footer />
</LayoutGalleryDetail>
