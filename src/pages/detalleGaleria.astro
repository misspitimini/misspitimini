---
import HeaderGalleryDetail from '@/components/header/HeaderGalleryDetail.astro';
import LayoutGalleryDetail from '@/layouts/LayoutGalleryDetail.astro';
import Footer from '@/components/footer/Footer.astro';
---

<LayoutGalleryDetail title="misspitimini | Galería de trabajos de Sara Laínez" description="Explora la galería de trabajos de diseño floral de misspitimini.">
	<HeaderGalleryDetail/>
	<main id="post-content-main" x-data="{ 
        activeSlideGallery: 0,
        get galleryLength() { 
            const container = document.querySelector('.card-content-thumb');
            return container ? container.children.length : 0;
        },
		touchstartX: 0,
		touchendX: 0,
		threshold: 50,
        imageOrientation: 'landscape',
        init() {
            const observer = new MutationObserver((mutations) => {
                for (const mutation of mutations) {
                    if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                        const img = Array.from(mutation.addedNodes).find(node => node.nodeName === 'IMG');
                        if (img) {
                            this.checkOrientation(img);
                        }
                    }
                }
            });
            observer.observe(this.$refs.slider, { childList: true });
        },
        checkOrientation(img) {
            const setOrientation = () => {
                this.imageOrientation = img.naturalHeight > img.naturalWidth ? 'portrait' : 'landscape';
            };
            if (img.complete) {
                setOrientation();
            } else {
                img.addEventListener('load', setOrientation, { once: true });
            }
        },
        centerThumbnail(index) {
            this.$nextTick(() => {
                const galleryContainer = this.$refs.galleryContainer;
                const selectedThumb = galleryContainer.querySelectorAll('button')[index];
                if (galleryContainer && selectedThumb) {
                    const containerWidth = galleryContainer.offsetWidth;
                    const thumbWidth = selectedThumb.offsetWidth;
                    const scrollLeft = selectedThumb.offsetLeft - (containerWidth / 2) + (thumbWidth / 2);
                    galleryContainer.scrollTo({ left: scrollLeft, behavior: 'smooth' });
                }
            });
        },
		next() {
            if (this.galleryLength === 0) return;
       	 	this.activeSlideGallery = (this.activeSlideGallery + 1) % this.galleryLength;
			window.updateCarousel(this.activeSlideGallery);
            this.centerThumbnail(this.activeSlideGallery);
		},
    	prev() {
            if (this.galleryLength === 0) return;
        	this.activeSlideGallery = (this.activeSlideGallery - 1 + this.galleryLength) % this.galleryLength;
			window.updateCarousel(this.activeSlideGallery);
            this.centerThumbnail(this.activeSlideGallery);
		},
		load(index) {
            this.activeSlideGallery = index;
            window.updateCarousel(this.activeSlideGallery);
            this.centerThumbnail(index);
        },
		changeClass(index) {
			 return this.activeSlideGallery === index ? 'border-black scale-105' : 'border-transparent opacity-60 hover:opacity-100';
		},
		handleGesture()  {
			const deltaX = this.touchendX - this.touchstartX;
			if (Math.abs(deltaX) > this.threshold) {
				deltaX < 0 ? this.next() : this.prev();
			}
		},
		images: ['']
    }"
    x-init="init()"
	@touchstart="touchstartX = $event.touches[0].screenX;"
    @touchend="touchendX = $event.changedTouches[0].screenX; handleGesture()"
	>
		<hr style="margin-bottom:2px; padding-bottom:2px"/>
		<div id="card-content-images" x-ref="slider" class="relative mx-auto overflow-hidden transition-all duration-300" :class="imageOrientation === 'landscape' ? 'w-full max-w-[800px]' : 'w-full max-w-[500px]'">
			<button @click="prev()" class="absolute left-3 md:left-2 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-white cursor-pointer">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
			</button>
			<button @click="next()" class="absolute right-3 md:right-2 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-white cursor-pointer">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			</button>
		</div>
		<div class="flex flex-col items-center gap-7">
            <h1 class="card-title">
                Donde las flores se convierten en recuerdos
            </h1>
        </div>
		 <div class="relative max-w-3xl mx-auto">
			<button @click="prev()" class="absolute -left-0 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-black cursor-pointer">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
			</button>
			<div class="card-content-thumb grid grid-flow-col auto-cols-max items-center justify-start gap-3 mt-4 overflow-x-auto p-2 scroll-smooth max-w-[280px] md:max-w-md mx-auto no-scrollbar" x-ref="galleryContainer">
				<template x-for="(img, index) in images" :key="`thumb-template_${index}`">
					<button type="button" @click="load(index)" class="relative h-20 min-w-max overflow-hidden rounded-md border-2 transition-all" :class="changeClass(index)">	
						<img :src="img" class="card-img w-full h-full object-cover hidden" loading="lazy">
					</button>
				</template>
			</div>
			<button @click="next()" class="absolute -right-0 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/20 hover:bg-white/40 backdrop-blur-sm transition-colors text-black cursor-pointer">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			</button>
		</div>
		<section>
			<div class="flex flex-col lg:flex-row items-center gap-7 p-2 md:p-4">
			  <div class="flex-1">
				<div class="card-content" >Cargando contenido...</div>
			  </div>
			</div>
		</section>
		<hr/>
		<div class="text-center">
			<a href="/galeria/" class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95 px-12">
				Volver
			</a>
		</div>
	</main>
	<Footer />
</LayoutGalleryDetail>