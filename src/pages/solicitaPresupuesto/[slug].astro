---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';
import logo from '@/assets/images/logos/logoReducido.png';

import LayoutWorkshopsBooking from '@/layouts/LayoutWorkshopsBooking.astro';
import WorkshopsBookingComponent from '@/components/workshop/WorkshopsBookingComponent.astro';
import Footer from '@/components/footer/Footer.astro';

import { getWorkshops } from '@/services/workshops';

export async function getStaticPaths() {
  // Fetch all workshops, including those with future dates
  const tallerFiles = await getWorkshops();
  return tallerFiles.map((post) => ({
    params: { slug: post.slug },
    props: { workshop: post },
  }));
}

const { slug } = Astro.params;
const { workshop } = Astro.props;
const title = `Taller de ${workshop.title} | misspitimini`;
const description = "Reserva tu plaza en nuestros talleres y experiencias florales.";

---

<LayoutWorkshopsBooking title={title} description={description}>
	
	<header>
		<div class="fixed top-0 inset-x-0 z-40 bg-white/80 backdrop-blur-md border-b border-floral-dark/5">
			<div class="relative flex items-center h-20 max-w-7xl mx-auto px-6">
				<!-- Left: Hamburger (mobile) / Logo (desktop) -->
				<div class="flex-1 flex justify-start">
					<!-- Desktop Logo -->
					<a href="/" class="hidden md:block">
						<OptimizedImage src={logo} alt="Bienvenidas a misspitimini" class="w-48 h-auto" />
					</a>
				 </div>
				
				<!-- Center: Logo (mobile) -->
				<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 md:hidden">
					<a href="/" class="block">
						<OptimizedImage src={logo} alt="Bienvenidas a misspitimini" class="w-40 h-auto" />
					</a>
				</div>
				
				<div class="absolute right-4">
					<a href="/experiencias/" class="text-gray-600 hover:text-black transition-colors">
						<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</header>
	<main class="relative pt-20 pb-12"> 

	<h1 class="sr-only">Solicita un presupuesto para talleres en Madrid por Sara Laínez, misspitimini</h1>
	 <div class="px-0 py-2 md:py-10 space-y-12"> 
		<div class="space-y-12"> 
            <WorkshopsBookingComponent workshop={workshop} />
		</div>
	</div>
</main>
<Footer />
</LayoutWorkshopsBooking>
