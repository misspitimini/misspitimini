---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';
import PressComponent from '@/components/press/PressComponent.astro';

const href = "/prensa/";
const title = "mispitimini | Contacto de Prensa y Colaboraciones";
const description = "Información de contacto para prensa, medios y colaboraciones. Descubre cómo podemos trabajar juntos.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const keywords = "prensa, mispitimini, contacto, medios, colaboraciones, diseño floral, Madrid";
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} keywords={keywords}>
    <Header href={href} />
    <main class="relative pt-20 pb-12">
        <h1 class="sr-only">Contacto de Prensa</h1>
        <SectionContainer>
            <PressComponent />
        </SectionContainer>
    </main>
    <Footer />
</Layout>
