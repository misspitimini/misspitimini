
---
import OptimizedImage from '@/components/commons/OptimizedImage.astro';
import logo from '@/assets/images/logos/logoReducido.png';
import bookingImage from '@/assets/images/carrusel/09_ramosFlores.jpg';
import LayoutBooking from '@/layouts/LayoutBooking.astro';
import WorkshopsBookingComponent from '@/components/workshop/WorkshopsBookingComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const title = "misspitimini | Reserva de asistencia a experiencias florales con Sara Laínez"
const description = "Reserva tu plaza en nuestros talleres y experiencias florales."
---

<LayoutBooking title={title} description={description}>
	
	<header>
		<div class="fixed top-0 inset-x-0 z-40 bg-white/80 backdrop-blur-md border-b border-floral-dark/5">
			<div class="relative flex items-center h-20 max-w-7xl mx-auto px-6">
				<!-- Left: Hamburger (mobile) / Logo (desktop) -->
				<div class="flex-1 flex justify-start">
					<!-- Desktop Logo -->
					<a href="/" class="hidden md:block">
						<OptimizedImage src={logo} alt="Logotipo de misspitimini" class="w-48 h-auto" />
					</a>
				 </div>
				
				<!-- Center: Logo (mobile) -->
				<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 md:hidden">
					<a href="/" class="block">
						<OptimizedImage src={logo} alt="Logotipo" class="w-40 h-auto" />
					</a>
				</div>
				
				<div class="absolute right-4">
					<a href="/experiencias/" class="text-gray-600 hover:text-black transition-colors">
						<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</header>
	<main class="relative pt-20 pb-12"> 

	<h1 class="sr-only">Solicita un presupuesto para talleres en Madrid por Sara Laínez, mispitimini</h1>
	<section class="relative w-full h-[85vh] md:h-[80vh]  overflow-hidden"> 
		<div class="absolute inset-0 w-full "> 
			<OptimizedImage 
			alt="Reserva asistencia" 
			class="w-full h-[85vh] md:h-[80vh] object-cover object-center" 
			decoding="async" 
			src={bookingImage}
			widths={[400, 800, 1200, 1600, 2400, 3200]}
			sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 50vw"
			quality={'60'}
   fetchpriority="high"
			/>
		</div>
		<div class="absolute inset-0 bg-black/10"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div> 
		<div class="absolute inset-0 flex flex-col justify-end p-12 md:p-8 pb-15 text-center items-center"> 
			<h2 class="uppercase text-white text-4xl font-serif italic leading-tight mb-3">Participa en nuestras experiencias florales</h2> 
			<h3 class="text-white text-4xl font-serif italic leading-tight mb-4 block text-sm md:text-lg tracking-widest mt-2">Compartamos de lo natural en comunidad</h3>
		</div> 
	</section> 

	 <div class="px-0 py-10 space-y-12"> 
		<div class="space-y-12"> 
		
			<WorkshopsBookingComponent />
		</div>
</div>
</main>
<Footer />
</LayoutBooking>
