---
import { Image } from 'astro:assets';
import logo from '@/assets/images/logos/logoReducido.png';
import bookingImage from '@/assets/images/carrusel/08_ramosFlores.jpg';
import LayoutBooking from '@/layouts/LayoutBooking.astro';
import WorkshopsBookingComponent from '@/components/workshop/WorkshopsBookingComponent.astro';
import Footer from '@/components/footer/Footer.astro';
---

<LayoutBooking title="misspitimini | Reserva de asistencia a experiencias florales con Sara Laínez" description="Reserva tu plaza en nuestros talleres y experiencias florales.">
	<header>
		<div class="relative w-full">
			
			<div class="flex flex-row items-center justify-between px-4 py-4 max-w-7xl mx-auto">
				<a href="/" class="z-50">
					<Image src={logo} alt="Logotipo" class="w-32 md:w-48 h-auto" />
				</a>
			</div>
			<div class="relative w-full max-w-7xl mx-auto overflow-hidden shadow-xl">
				<div class="relative h-[150px] md:h-[150px]">
					<Image src={bookingImage} alt="Reserva asistencia" class="w-full h-full object-cover" />
					<div class="absolute inset-0 bg-black/10"></div>
				</div>
			</div>
		</div>
	</header>
	<main>
        <h1 class="text-4xl font-serif text-center py-12">Solicita un presupuesto</h1>
		<WorkshopsBookingComponent />
	</main>
	<Footer />
</Layout>