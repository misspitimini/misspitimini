---
import LayoutEmail from '@layouts/LayoutEmail.astro';
import Header from '@components/header/Header.astro';
import Carrusel from '@components/header/Carrusel.astro';
import ContactComponent from '@components/ContactComponent.astro';
import Footer from '@components/footer/Footer.astro';

const href="/contacto/";
---

<LayoutEmail title="misspitimini | Contacta con Sara Laínez" description="Contacta para solicitar presupuesto o información sobre nuestros servicios de diseño floral.">
	<Header href={href}  />
	<main class="relative pt-20 pb-12">
		<Carrusel href={href} />
        <h1 class="sr-only">Contacto</h1>
		<div class="px-2 py-20 space-y-24">
			<ContactComponent />
		</div>
	</main>
	<Footer />
</LayoutEmail>
