---
import LayoutEmail from '@layouts/LayoutEmail.astro';
import Header from '@components/header/Header.astro';
import HeroIndex from '@components/commons/HeroIndex.astro';
import ContactComponent from '@components/ContactComponent.astro';
import Footer from '@components/footer/Footer.astro';
---

<LayoutEmail title="misspitimini | Contacta con Sara Laínez">
	<Header  activeSlide={6} href="/contacto/"  />
	<main class="relative pt-20 pb-12">
		<HeroIndex  activeSlide={6} href="/contacto/"  />
		
		<div class="px-2 py-20 space-y-24">
			<ContactComponent />
		</div>
	</main>
	<Footer />
</LayoutEmail>
