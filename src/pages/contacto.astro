---
import LayoutEmail from '@/layouts/LayoutEmail.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import ContactComponent from '@/components/contact/ContactComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/contacto/";
---

<LayoutEmail title="misspitimini | Contacta con Sara Laínez" description="Contacta para solicitar presupuesto o información sobre nuestros servicios de diseño floral.">
	<Header href={href}  />
	<main class="relative pt-20 pb-12">
		<h1 class="hidden">Diseño Floral para bodas, evento y experiencias en Madrid</h1>
		<Carrusel href={href} />
        <h2 class="sr-only">Contacto</h1>
		<div class="px-0 py-10 space-y-12">
			<ContactComponent />
		</div>
	</main>
	<Footer />
</LayoutEmail>
