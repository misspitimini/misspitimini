---
import LayoutEmail from '@/layouts/LayoutEmail.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import ContactComponent from '@/components/contact/ContactComponent.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/contacto/";
---

<LayoutEmail title="misspitimini | Contacta con Sara Laínez" description="Contacta para solicitar presupuesto o información sobre nuestros servicios de diseño floral.">
	<Header href={href}  />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Contacta con Diseñora Floral para eventos, bodas y experiencias en Madrid</h1>
		<Carrusel href={href} />
		<SectionContainer>
			<ContactComponent />
		</SectionContainer>
	</main>
	<Footer />
</LayoutEmail>
