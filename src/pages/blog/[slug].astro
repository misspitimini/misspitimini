---
import LayoutBlogDetail from '@/layouts/LayoutBlogDetail.astro';
import HeaderBlogDetail from '@/components/header/HeaderBlogDetail.astro';
import SectionTitle from '@/components/commons/SectionTitle.astro';
import Footer from '@/components/footer/Footer.astro';
import { getBlogsDetail } from '@/services/blogDetail';
import { UrlsApi } from "@/ts/urls";

import type { BlogDetail } from '@/types/BlogDetail'; // Asegúrate de importar la interfaz

import { marked } from 'marked';


export async function getStaticPaths() {
  const blogs = await getBlogsDetail();
  return blogs.map((entry: BlogDetail) => ({
    params: { slug: entry.slug }, // Genera /blog/titulo-del-post
    props: { entry }, // Le inyectamos todo el objeto (incluyendo el content)
  }));
}

const { slug } = Astro.params;
let { entry } = Astro.props;

// 2. VALIDACIÓN (Opcional pero recomendada para evitar el error 500 si falla el fetch)
if (!entry) {
  entry = {
    slug: slug,
    title: "Post sin título",
    description: "Entrada del blog de misspitimini.",
    imgSrc: UrlsApi.DEFAULT_IMAGE,
    imgAlt: "Sara Laínez, diseñadora floral",
    pubDate: "2026-02-08",
    author: "Sara Laínz, misspitimini",
    tags: [],
    body: "",
  }
}

// Definimos constantes para limpiar el HTML
const { 
  title, 
  description, 
  imgSrc, 
  imgAlt, 
  pubDate, 
  author, 
  tags = [], // Valor por defecto por si tags es undefined
  body, 
} = entry;

// Transformaciones consistentes
const keywords = tags.join(', ');
const content = (body)? await marked.parse(body): '';

// 3. RENDERIZACIÓN;
---

<LayoutBlogDetail title={`${title} | misspitimini`} description={description} keywords={keywords}  />
    <HeaderBlogDetail imgSrc={imgSrc} imgAlt={imgAlt} />
    <main id="post-content-main">
        <section class="space-y-10">
          <SectionTitle>{title}</SectionTitle>

          <div class="justify-end text-sm text-slate-500 text-right mr-2 xl:mr-80">
            <div class="items-center gap-1.5 justify-end">
                <span class="card-author">
                    {author}
                </span>
                <span></span> 
                &nbsp;-&nbsp;
              </span>
                <span class="card-date">
                    {pubDate}
                </span>
            </div>
        </div>

              <div class="relative w-full max-w-7xl mx-auto py-4 flex items-center justify-end">
                  <!-- IMPORTANTE: Aquí es donde vive el contenido según tu interfaz -->
                  <div class="card-content" set:html={content}></div>
              </div>  
           
        </section>

        <div class="text-center mt-8">
          <a href="/blog/" class="bg-black text-white py-3 px-12 rounded-full">
            Volver
          </a>
        </div>
    </main>
    <Footer />
</LayoutBlogDetail>