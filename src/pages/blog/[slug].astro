---
import LayoutBlogDetail from '@/layouts/LayoutBlogDetail.astro';
import HeaderBlogDetail from '@/components/header/HeaderBlogDetail.astro';
import SectionTitle from '@/components/commons/SectionTitle.astro';
import Footer from '@/components/footer/Footer.astro';
import { getBlogsDetail } from '@/services/blogDetail';
import { UrlsApi } from "@/ts/urls";
import type { BlogDetail } from '@/types/BlogDetail';
import { marked } from 'marked';

export async function getStaticPaths() {
  const blogs = await getBlogsDetail();
  return blogs.map((entry: BlogDetail) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { slug } = Astro.params;
let { entry } = Astro.props;

if (!entry) {
  entry = {
    slug: slug,
    title: "Post sin título",
    description: "Entrada del blog de misspitimini.",
    imgSrc: UrlsApi.DEFAULT_IMAGE,
    imgAlt: "Sara Laínez, diseñadora floral",
    pubDate: "2026-02-08",
    author: "Sara Laínz, misspitimini",
    tags: [],
    body: "",
  } as BlogDetail
}

const { 
  title, 
  description, 
  imgSrc, 
  imgAlt, 
  pubDate, 
  author, 
  tags = [],
  body, 
} = entry;

const keywords = ((typeof tags === 'string') ? JSON.parse(tags): tags).join(', ');
const content = (body)? await marked.parse(body): '';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<LayoutBlogDetail title=`${title} | misspitimini` description={description} keywords={keywords} canonicalUrl={canonicalUrl}>
    <Fragment slot="page-styles">
      <style is:global>
        body {
            @apply block;
        }
        p {
            @apply m-0 md:m-0 text-center;
        }
        main h1, h2, h3 {
            @apply font-serif text-4xl md:text-5xl text-floral-dark tracking-tight leading-tight italic m-2 text-center;
        }
        main hr {
            @apply font-display text-4xl font-semibold text-gray-900 mb-4 tracking-wide pb-12 md:pb-0 text-center;
        }
        main p {
            @apply font-body text-base text-gray-600 leading-relaxed text-justify tracking-wide m-4 md:m-6;
        }
        main p > img {
            @apply block indent-0 max-w-none my-8 relative left-1/2 -translate-x-1/2 w-[calc(100%+2rem)] md:w-1/2 md:left-auto md:translate-x-0 md:mx-auto;
        }
        main p.card-title {
            @apply text-xl md:text-3xl font-serif italic text-gray-800 text-center py-2;
        }
        main ul {
            @apply list-disc ml-12 md:ml-24 mb-4;
        }
        main table {
            @apply min-w-full border-collapse my-6;
        }
        main td, main th {
            @apply border border-gray-300 px-4 py-2 text-left;
        }
        main blockquote {
            @apply border-l-4 border-gray-200 pl-6 my-6 mx-2;
        }
      </style>
    </Fragment>

    <HeaderBlogDetail imgSrc={imgSrc} imgAlt={imgAlt} />

    <main id="post-content-main">
        <section class="space-y-10">
          <SectionTitle>{title}</SectionTitle>

          <div class="relative w-full max-w-7xl mx-auto py-4 flex items-center justify-end">
            <div class="items-end gap-1.5 justify-end mr-6">
                <span class="card-author">{author}</span>
                <span>&nbsp;-&nbsp;</span>
                <span class="card-date">{pubDate}</span>
            </div>
          </div>

          <div class="relative w-full max-w-7xl mx-auto py-4 flex items-center justify-end">
              <div class="card-content" set:html={content}></div>
          </div>
        </section>

        <div class="text-center mt-8">
          <a href="/blog/" class="bg-black text-white py-3 px-12 rounded-full">
            Volver
          </a>
        </div>
    </main>

    <Footer />
</LayoutBlogDetail>