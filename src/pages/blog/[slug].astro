---
import Layout from '@/layouts/Layout.astro';
import blogEntries from "@/data/blog.json";

// 1. Definimos la "forma" de una entrada de blog.
interface BlogEntry {
  slug: string;
  title: string;
  description: string;
  image: string;
  content: string;
}

export async function getStaticPaths() {
    // 2. Le decimos a TypeScript que `blogEntries` es un array de `BlogEntry`
    return (blogEntries as BlogEntry[]).map(entry => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

// 3. Tipamos los props que recibe la página.
export type Props = {
  entry: BlogEntry;
};

const { entry } = Astro.props;
---

<Layout title={entry.title} description={entry.description}>
    <main class="container mx-auto px-4 py-16">
        <article class="prose lg:prose-xl mx-auto">
            <img src={entry.image} alt={entry.title} class="w-full h-auto object-cover rounded-lg mb-8" />
            <h1>{entry.title}</h1>
            <p class="text-gray-600">{entry.description}</p>
            <div set:html={entry.content} />
        </article>
    </main>
</Layout>
