---
import { Image } from 'astro:assets';
import logo from '@/assets/images/logos/logoReducido.png';
import blogImage from '@/assets/images/carrusel/08_ramosFlores.jpg';
import LayoutBlogDetail from '@/layouts/LayoutBlogDetail.astro';
import Footer from '@/components/footer/Footer.astro';
---

<LayoutBlogDetail title="misspitimini | Blog de Sara Laínez" description="Entrada del blog de misspitimini. Desvelando el encanto de las flores.">
	<header id="post-content-header">
		<div class="relative w-full max-w-7xl mx-auto px-4 py-4 flex items-center justify-center">
			<div class="flex flex-row items-center justify-between px-4 py-4 max-w-7xl mx-auto">
				<a href="/" class="z-50">
					<Image src={logo} alt="Logotipo" class="w-32 md:w-48 h-auto" />
				</a>
			</div>
			<div class="absolute right-4">
				<a href="/blog/" class="text-gray-600 hover:text-black transition-colors">
					<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</a>
			</div>
		</div>
		<div class="relative w-full max-w-7xl mx-auto overflow-hidden shadow-xl">
			<div class="relative h-[350px] md:h-[500px]">
				<Image src={blogImage} alt="Reserva asistencia" class="card-img w-full h-full object-cover" />
				<div class="absolute inset-0 bg-black/10"></div>
			</div>
		</div>
	</header>
	<main id="post-content-main" class="relative pt-20 pb-12">

		<section class="space-y-10">
			<div class="text-center space-y-2">
			  <h1 class="card-title text-3xl font-serif">Donde las flores se convierten en recuerdos</h1>
			  <div class="h-px w-12 bg-primary mx-auto"></div>
			</div>
			<div class="flex flex-wrap justify-end gap-y-2 gap-x-4 text-sm text-slate-500 mb-4 md:p-8">
				<div class="flex items-center gap-1.5">
				  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-circle"><circle cx="12" cy="12" r="10"/><path d="M11 8a2 2 0 1 1 2 2 2 2 0 0 1-2-2z"/><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"/></svg>
				  <span class="card-author">Sara Laínz, misspitimini</span>
				</div>
				
				<div class="flex items-center gap-1.5">
				  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
				  <span class="card-date"></span>
				</div>
			  </div>

			  <div class="flex flex-col lg:flex-row items-center gap-7 p-4">
				<div class="card-content flex-1 text-center">
					Cargando contenido...
				</div>	
			</div>
		  </div>
		  </section>
		  <hr/>
		  <div class="text-center">
			<a href="/blog/" 
			class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:bg-gray-800 transition-transform active:scale-95 px-12">
			Volver
			</a>
		  </div>
	</main>
	<Footer />
</LayoutBlogDetail>