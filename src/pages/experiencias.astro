---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import WorkshopsComponent from '@/components/workshop/WorkshopsComponent.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/experiencias/";

const title = "misspitimini | Talleres Florales y Experiencias Gastronómicas por Sara Laínez en Madrid" 
const h1 = "Talleres y experiencias florales en Madrid"
const description = "Participa en nuestros talleres y experiencias florales y gastronómicas. Aprende a crear tu propio diseño floral." 
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const keywords = "diseño floral, bodas, eventos, talleres florales, experiencias, Madrid, florista, ramos de novia, decoración floral"
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} keywords={keywords} >
	<!--Fragment slot="body-scripts">
        <script>
            import '@/ts/workshops.ts';
        </script>
    </Fragment-->
	<Header href={href} h1={h1} />
	<main class="relative pt-20 pb-12">
		<Carrusel href={href} />
		<SectionContainer>
			<WorkshopsComponent />
		</SectionContainer>
	</main>
	<Footer />
</Layout>