---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import WorkshopsComponent from '@/components/workshop/WorkshopsComponent.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/experiencias/";

const title = "mispitimini | Experiencias y Talleres Florales y Gastronómicas por Sara Laínez en Madrid" 
const description = "Participa en nuestros talleres y experiencias florales y gastronómicas. Aprende a crear tus propios arreglos florales." 
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const keywords = "florista, bodas, eventos, talleres florales, experiencias, Madrid, diseño floral, ramos de novia, decoración floral"
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} keywords={keywords} >
	<Fragment slot="body-scripts">
		<script type="module" src="/ts/workshops.ts"></script>
	</Fragment>
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Talleres y experiencias florales en Madrid</h1>
		<Carrusel href={href} />
		<SectionContainer>
			<WorkshopsComponent />
		</SectionContainer>
	</main>
	<Footer />
</Layout>