---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import WorkshopsComponent from '@/components/workshop/WorkshopsComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/experiencias/";
---

<Layout title="misspitimini | Experiencias florales con Sara Laínez" description="Participa en nuestros talleres y experiencias florales. Aprende a crear tus propios arreglos florales.">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="hidden">Diseño Floral para bodas, evento y experiencias en Madrid</h1>
		<Carrusel href={href} />
        <h2 class="sr-only">Experiencias</h1>
		<div class="px-0 py-10 space-y-12">
			<WorkshopsComponent />
		</div>
	</main>
	<Footer />
</Layout>