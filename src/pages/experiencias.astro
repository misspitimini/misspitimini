---
import Layout from '@layouts/Layout.astro';
import Header from '@components/header/Header.astro';
import Carrusel from '@components/header/Carrusel.astro';
import WorkshopsComponent from '@components/workshop/WorkshopsComponent.astro';
import Footer from '@components/footer/Footer.astro';

const href="/experiencias/";
---

<Layout title="misspitimini | Experiencias florales con Sara Laínez">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<Carrusel href={href} />
        <h1 class="sr-only">Experiencias</h1>
		<div class="py-20 space-y-24">
			<WorkshopsComponent />
		</div>
	</main>
	<Footer />
</Layout>