---
import LayoutGallery from '@/layouts/LayoutGallery.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import GalleryComponent from '@/components/gallery/GalleryComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/galeria/";
---

<LayoutGallery title="Galería de fotos de eventos florales | Sara Laínez, mispitimini" description="Explora la galería de fotos de nuestras bodas, eventos y experiencias florales y gastronímicas. Inspírate para tu próximo evento.">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Galería de fotos e imágenes que sirven de inspiración para bodas, evento y experiencias florales y gastronómicas por Sara Laínez, mispitimini</h1>
		<Carrusel href={href}/>
		<div class="px-0 py-20 space-y-24">
			<GalleryComponent />
		</div>
	</main>
	<Footer />
</LayoutGallery>