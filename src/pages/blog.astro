---
import LayoutBlog from '@/layouts/LayoutBlog.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import BlogComponent from '@/components/blog/BlogComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/blog/";
---

<LayoutBlog 
    title="Blog de Diseño Floral | Sara Laínez" 
    description="Explora el blog de Sara Laínez para obtener ideas y consejos sobre diseño floral, decoración de bodas, eventos y talleres creativos en Madrid."
    keywords="blog, diseño floral, bodas, eventos, talleres, Madrid, Sara Laínez, inspiración, consejos"
>
	<Header href={href} />
	<main class="relative pt-20 pb-12">
        <div class="sr-only">
		    <h1 class="text-4xl font-serif font-bold text-floral-dark">Blog de Diseño Floral</h1>
            <p class="text-lg text-floral-dark/80 mt-2">Ideas y consejos sobre diseño floral</p>
        </div>
		<Carrusel href={href} />
		<div class="px-0 py-10 space-y-12">
			<BlogComponent />
		</div>
	</main>
	<Footer />
</LayoutBlog>
