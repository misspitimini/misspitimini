---
import LayoutBlog from '@layouts/LayoutBlog.astro';
import Header from '@components/header/Header.astro';
import ArrowsCarrusel from '@components/commons/ArrowsCarrusel.astro';
import BlogComponent from '@components/blog/BlogComponent.astro';
import Footer from '@components/footer/Footer.astro';
---

<LayoutBlog title="misspitimini | Blog de Sara Laínez">
	<Header activeSlide={7} href="/blog/" />
	<main class="relative pt-20 pb-12">
		<ArrowsCarrusel href="/blog/" />
		<div class="py-20 space-y-24">
			<BlogComponent />
		</div>
	</main>
	<Footer />
</LayoutBlog>
