---
import LayoutBlog from '@/layouts/LayoutBlog.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import BlogComponent from '@/components/blog/BlogComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/blog/";
---

<LayoutBlog title="misspitimini | Blog de Sara Laínez" description="Descubre artículos sobre diseño floral, bodas, eventos y mucho más.">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="hidden">Diseño Floral para bodas, evento y experiencias en Madrid</h1>
		<Carrusel href={href} />
		<div class="py-20 space-y-24">
			<BlogComponent />
		</div>
	</main>
	<Footer />
</LayoutBlog>
