---
import LayoutBlog from '@layouts/LayoutBlog.astro';
import HeaderIndex from '@components/commons/HeaderIndex.astro';
import HeroIndex from '@components/commons/HeroIndex.astro';
import BlogComponent from '@components/BlogComponent.astro';
import Footer from '@components//commons/Footer.astro';
---

<LayoutBlog title="misspitimini | Blog de Sara Laínez">
	<HeaderIndex activeSlide={7} href="/blog/" />
	<main class="relative pt-20 pb-12">
		<HeroIndex activeSlide={7} href="/blog/" />
		<div class="py-20 space-y-24">
			<BlogComponent />
		</div>
	</main>
	<Footer />
</LayoutBlog>
