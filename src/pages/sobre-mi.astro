---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/about/About.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/sobre-mi/";
---

<Layout title="misspitimini | Sobre mi" description="Conoce a Sara Laínez, la diseñadora floral detrás de misspitimini."
keywords="florista, bodas, eventos, talleres florales, experiencias, Madrid, diseño floral, ramos de novia, decoración floral"
>
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Sobre mí – Sara Laínez, diseñadora floral en Madrid</h1>
		<Carrusel href="/sobre-mi/" />
		<SectionContainer>
			<About />
		</SectionContainer>
	</main>
	<Footer />
</Layout>