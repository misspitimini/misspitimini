---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/about/About.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/sobre-mi/";

const title="misspitimini | Sobre mi" 
const h1= "Sobre mí – Sara Laínez, diseñadora floral en Madrid"
const description="Conoce a Sara Laínez, la diseñadora floral detrás de misspitimini."
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
const keywords = "florista, bodas, eventos, talleres florales, experiencias, Madrid, diseño floral, ramos de novia, decoración floral"
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} keywords={keywords} >
	<Header href={href} h1={h1} />
	<main class="relative pt-20 pb-12">
		<Carrusel href="/sobre-mi/" />
		<SectionContainer>
			<About />
		</SectionContainer>
	</main>
	<Footer />
</Layout>