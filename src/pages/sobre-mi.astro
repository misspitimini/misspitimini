---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/about/About.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/sobre-mi/";
---

<Layout title="misspitimini | Sobre mi" description="Conoce a Sara Laínez, la diseñadora floral detrás de misspitimini.">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="text-4xl font-serif text-center py-12">Sobre mí</h1>
		<Carrusel href="/sobre-mi/" />
		<div class="py-10 space-y-24">
			<About />
		</div>
	</main>
	<Footer />
</Layout>