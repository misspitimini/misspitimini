---
import Layout from '@layouts/Layout.astro';
import galleries from '@data/gallery.json';

export async function getStaticPaths() {
    return galleries.map(gallery => ({
        params: { slug: gallery.slug },
        props: { gallery },
    }));
}

const { gallery } = Astro.props;
---

<Layout title={gallery.title} description={gallery.description}>
    <main class="container mx-auto px-4 py-16">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-serif mb-4">{gallery.title}</h1>
            <p class="text-lg text-gray-600 max-w-3xl mx-auto">{gallery.description}</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {gallery.images.map((image) => (
                <div class="overflow-hidden rounded-lg">
                    <img src={image.src} alt={image.alt} class="w-full h-full object-cover aspect-square" loading="lazy" />
                </div>
            ))}
        </div>
    </main>
</Layout>
