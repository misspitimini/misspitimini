---
import Layout from '@/layouts/Layout.astro';
import galleries from '@/content/galleries.json';

// 1. Definimos la "forma" de un objeto de la galería.
interface Gallery {
  imgSrc: string;
  imgAlt: string;
  title: string;
  description: string;
  link: string;
}

export async function getStaticPaths() {
    return (galleries as Gallery[]).map(gallery => ({
        params: { slug: gallery.link.split('/').pop() },
        props: { gallery },
    }));
}

// 3. Tipamos los props que recibe la página.
export type Props = {
  gallery: Gallery;
};

const { gallery } = Astro.props;
---

<Layout title={gallery.title} description={gallery.description}
keywords="florista, bodas, eventos, talleres florales, experiencias, Madrid, diseño floral, ramos de novia, decoración floral">
    <main class="container mx-auto px-4 py-16">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-serif mb-4">{gallery.title}</h1>
            <p class="text-lg text-gray-600 max-w-3xl mx-auto">{gallery.description}</p>
        </div>

        <div class="flex justify-center">
             <div class="overflow-hidden rounded-lg max-w-4xl">
                <img src={gallery.imgSrc} alt={gallery.imgAlt} class="w-full h-full object-cover" loading="lazy" />
            </div>
        </div>
    </main>
</Layout>
