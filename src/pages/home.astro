---
import Layout from '@layouts/Layout.astro';
import Header from '@components/header/Header.astro';
import ArrowsCarrusel from '@components/commons/ArrowsCarrusel.astro';
import HomeComponent from '@components/HomeComponent.astro';
import Footer from '@components/footer/Footer.astro';
---

<Layout title="misspitimini | Floral Design by Sara Laínez">
	<Header activeSlide={1} href="/"  />
	<main class="relative pt-20 pb-12">
		<ArrowsCarrusel href="/" />
		<div class="px-6 py-20 space-y-24">
			<HomeComponent />
		</div>
	</main>
	<Footer />
</Layout>