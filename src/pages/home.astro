---
import Layout from '@layouts/Layout.astro';
import HeaderIndex from '@components/commons/HeaderIndex.astro';
import HeroIndex from '@components/commons/HeroIndex.astro';
import HomeComponent from '@components/HomeComponent.astro';
import Footer from '@components//commons/Footer.astro';
---

<Layout title="misspitimini | Floral Design by Sara Laínez">
	<HeaderIndex activeSlide={1} href="/"  />
	<main class="relative pt-20 pb-32">
		<HeroIndex activeSlide={1} href="/" />
		
		<div class="px-6 py-20 space-y-24">
			<HomeComponent />
		</div>
	</main>
	<Footer />
</Layout>