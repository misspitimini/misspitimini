---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import EventsComponent from '@/components/eventscorporate/EventsComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/eventos/";
---

<Layout title="Decoración Foral para Eventos y Empresas en Madrid | Sara Laínez, mispitimini" description="Flores para eventos corporativos y privados con estilo natural y elegante.">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Diseño Floral para eventos en Madrid por Sara Laínez, mispitimini</h1>
		<Carrusel href={href} />
		<div class="px-0 py-10 space-y-12">
			<EventsComponent />
		</div>
	</main>
	<Footer />
</Layout>