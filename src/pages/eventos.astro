---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import EventsComponent from '@/components/eventscorporate/EventsComponent.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/eventos/";
---

<Layout title="mispitimini | Decoración Foral para Eventos y Empresas por Sara Laínez en Madrid" description="Flores para eventos corporativos y privados con estilo natural y elegante."
keywords="florista, bodas, eventos, talleres florales, experiencias, Madrid, diseño floral, ramos de novia, decoración floral"
>
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Decoración floral para eventos en Madrid</h1>
		<Carrusel href={href} />
		<SectionContainer>
			<EventsComponent />
		</SectionContainer>
	</main>
	<Footer />
</Layout>