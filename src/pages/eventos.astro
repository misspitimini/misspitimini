---
import Layout from '@layouts/Layout.astro';
import Header from '@components/header/Header.astro';
import ArrowsCarrusel from '@components/header/ArrowsCarrusel.astro';
import EventsComponent from '@components/EventsComponent.astro';
import Footer from '@components/footer/Footer.astro';

const href="/eventos/";
---

<Layout title="misspitimini | Decoración floral para Eventos con Sara Laínez">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<ArrowsCarrusel href={href} />
		<div class="py-20 space-y-24">
			<EventsComponent />
		</div>
	</main>
	<Footer />
</Layout>