---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import EventsComponent from '@/components/eventscorporate/EventsComponent.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/eventos/";

const title = "mispitimini | Decoración Foral para Eventos y Empresas por Sara Laínez en Madrid" 
const h1 = "Decoración floral para eventos en Madrid"
const description = "Flores para eventos corporativos y privados con estilo natural y elegante."
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const keywords = "diseño floral, bodas, eventos, talleres florales, experiencias, Madrid, florista, ramos de novia, decoración floral"

---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} keywords={keywords} >
	<Header href={href} h1={h1} />
	<main class="relative pt-20 pb-12">
		<Carrusel href={href} />
		<SectionContainer>
			<EventsComponent />
		</SectionContainer>
	</main>
	<Footer />
</Layout>