---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import WeddingComponent from '@/components/weddings/WeddingsComponent.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/bodas/";
---

<Layout title="mispitimini | Ramos y Decoración Floral para Bodas por Sara Laínez en Madrid " description="Diseño floral personalizado para bodas: Ramos de novia, ceremonias, centros, estructuras florales, montajes y más.">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Diseño Floral para bodas en Madrid por Sara Laínez, mispitimini</h1>
		<Carrusel href={href} />
		<div class="px-0 py-10 space-y-12">
			<WeddingComponent />
		</div>
	</main>
	<Footer />
</Layout>