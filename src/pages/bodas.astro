---
import Layout from '@layouts/Layout.astro';
import Header from '@components/header/Header.astro';
import Carrusel from '@components/header/Carrusel.astro';
import WeddingComponent from '@components/WeddingComponent.astro';
import Footer from '@components/footer/Footer.astro';

const href="/bodas/";
---

<Layout title="Ramos y Decoración Floral para Bodas en Madrid" description="Diseño floral personalizado para bodas: Ramos de novia, ceremonias, centros y más.">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="hidden">Diseño Floral para bodas, evento y experiencias en Madrid</h1>
		<Carrusel href={href} />
        <h2 class="sr-only">Bodas</h1>
		<div class="px-0 py-10 space-y-12">
			<WeddingComponent />
		</div>
	</main>
	<Footer />
</Layout>