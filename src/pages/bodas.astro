---
import Layout from '@layouts/Layout.astro';
import HeaderIndex from '@components/commons/HeaderIndex.astro';
import HeroIndex from '@components/commons/HeroIndex.astro';
import WeddingComponent from '@components/WeddingComponent.astro';
import Footer from '@components//commons/Footer.astro';
---

<Layout title="misspitimini | Decoración floral para bodas con Sara Laínez">
	<HeaderIndex activeSlide={2} href="/bodas/" />
	<main class="relative pt-20 pb-12">
		<HeroIndex activeSlide={2} href="/bodas/" />
		
		<div class="py-20 space-y-24">
			<WeddingComponent />
		</div>
	</main>
	<Footer />
</Layout>