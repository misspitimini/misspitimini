---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/header/Header.astro';
import Carrusel from '@/components/header/Carrusel.astro';
import WeddingComponent from '@/components/weddings/WeddingsComponent.astro';
import SectionContainer from '@/components/layout/SectionContainer.astro';
import Footer from '@/components/footer/Footer.astro';

const href="/bodas/";

const title="mispitimini | Ramos y Decoración Floral para Bodas por Sara Laínez en Madrid"
const description="Diseño floral personalizado para bodas: Ramos de novia, ceremonias, centros, estructuras florales, montajes y más."
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const keywords = "florista, bodas, eventos, talleres florales, experiencias, Madrid, diseño floral, ramos de novia, decoración floral"
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} keywords={keywords}>
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<h1 class="sr-only">Decoración floral para bodas en Madrid</h1>
		<Carrusel href={href} />
		<SectionContainer>
			<WeddingComponent />
		</SectionContainer>
	</main>
	<Footer />
</Layout>