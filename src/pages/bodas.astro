---
import Layout from '@layouts/Layout.astro';
import Header from '@components/header/Header.astro';
import Carrusel from '@components/header/Carrusel.astro';
import WeddingComponent from '@components/WeddingComponent.astro';
import Footer from '@components/footer/Footer.astro';

const href="/bodas/";
---

<Layout title="misspitimini | Decoración floral para bodas con Sara Laínez">
	<Header href={href} />
	<main class="relative pt-20 pb-12">
		<Carrusel href={href} />
        <h1 class="sr-only">Bodas</h1>
		<div class="py-20 space-y-24">
			<WeddingComponent />
		</div>
	</main>
	<Footer />
</Layout>